---
import Layout from '../layouts/Layout.astro';
import buildsData from '../../builds.json';

const base = import.meta.env.BASE_URL;

// Pre-compute total score for each build
const builds = buildsData.map(b => ({
  ...b,
  total: Math.round(
    (b.ratings.dpr + b.ratings.ehp + b.ratings.control + b.ratings.support + b.ratings.utility) / 5
  ),
}));
---

<Layout title="Ranking" description="Tabla comparativa de builds ordenadas por puntuaciones.">
  <section class="hero" style="padding-bottom:1rem">
    <h1 class="hero-title" style="font-size:clamp(2rem,4vw,3.5rem)">Ranking</h1>
    <p class="hero-subtitle" style="margin-bottom:0">
      Compara todas las builds por estadísticas. Haz clic en una columna para ordenar.
    </p>
  </section>

  <div class="rank-wrap">
    <!-- Controls -->
    <div class="filter-panel" style="padding:0">
      <div class="filter-main-bar">
        <div class="search-wrap">
          <svg class="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input id="rank-search" type="search" class="search-input" placeholder="Buscar en ranking... (ej: -wizard o -2014)"
                 aria-label="Filtrar builds" autocomplete="off" />
        </div>

        <!-- Sorter -->
        <div class="filter-item">
          <select id="rank-sort-by" class="filter-select filter-sort" aria-label="Ordenar por">
            <option value="total">Ordenar: Puntuación Total</option>
            <option value="dpr">Ordenar: DPR</option>
            <option value="ehp">Ordenar: EHP</option>
            <option value="control">Ordenar: Control</option>
            <option value="support">Ordenar: Soporte</option>
            <option value="utility">Ordenar: Utilidad</option>
            <option value="complexity">Ordenar: Complejidad</option>
            <option value="name">Ordenar: Nombre</option>
          </select>
          <button id="rank-sort-dir" type="button" class="btn-sort-dir" title="Cambiar dirección de orden" aria-label="Dirección de orden">
            <span id="rank-sort-dir-icon">↓</span> <span id="rank-sort-dir-text">Desc</span>
          </button>
        </div>

        <!-- Toggle Drawer Button -->
        <button id="rank-btn-toggle-drawer" type="button" class="btn-toggle-filters" aria-expanded="false">
          <span>🎛️ Filtros &amp; Exclusiones</span>
          <span id="rank-filter-badge-count" class="badge-count" style="display:none">0</span>
          <span id="rank-drawer-arrow">▼</span>
        </button>

        <!-- Reset Button -->
        <button id="rank-btn-reset" type="button" class="btn-reset-filters" style="display:none">
          ✕ Limpiar
        </button>

        <span class="filter-label" style="margin-left:auto">
          <span id="rank-count">{builds.length}</span> builds
        </span>
      </div>

      <!-- Collapsible Glass Drawer -->
      <div id="rank-filter-drawer" class="filter-drawer hidden">
        <!-- Inclusion Group -->
        <div class="drawer-section">
          <span class="drawer-title include-title">🎯 Incluir</span>
          <div class="drawer-grid">
            <div class="multi-select" id="rank-ms-system" data-placeholder="Sistema: Todos" data-type="include">
              <button type="button" class="multi-select-btn">
                <span class="multi-select-label">Sistema: Todos</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option"><input type="checkbox" value="2014"> <span>2014</span></label>
                <label class="multi-select-option"><input type="checkbox" value="2024"> <span>2024 / 5.5e</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-class" data-placeholder="Clase: Todas" data-type="include">
              <button type="button" class="multi-select-btn">
                <span class="multi-select-label">Clase: Todas</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option"><input type="checkbox" value="artificer"> <span>Artificer</span></label>
                <label class="multi-select-option"><input type="checkbox" value="barbarian"> <span>Barbarian</span></label>
                <label class="multi-select-option"><input type="checkbox" value="bard"> <span>Bard</span></label>
                <label class="multi-select-option"><input type="checkbox" value="cleric"> <span>Cleric</span></label>
                <label class="multi-select-option"><input type="checkbox" value="druid"> <span>Druid</span></label>
                <label class="multi-select-option"><input type="checkbox" value="fighter"> <span>Fighter</span></label>
                <label class="multi-select-option"><input type="checkbox" value="monk"> <span>Monk</span></label>
                <label class="multi-select-option"><input type="checkbox" value="paladin"> <span>Paladin</span></label>
                <label class="multi-select-option"><input type="checkbox" value="ranger"> <span>Ranger</span></label>
                <label class="multi-select-option"><input type="checkbox" value="rogue"> <span>Rogue</span></label>
                <label class="multi-select-option"><input type="checkbox" value="sorcerer"> <span>Sorcerer</span></label>
                <label class="multi-select-option"><input type="checkbox" value="warlock"> <span>Warlock</span></label>
                <label class="multi-select-option"><input type="checkbox" value="wizard"> <span>Wizard</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-role" data-placeholder="Rol: Todos" data-type="include">
              <button type="button" class="multi-select-btn">
                <span class="multi-select-label">Rol: Todos</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option"><input type="checkbox" value="tanque"> <span>Tanque</span></label>
                <label class="multi-select-option"><input type="checkbox" value="atacante"> <span>Atacante (Striker)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="controlador"> <span>Controlador</span></label>
                <label class="multi-select-option"><input type="checkbox" value="soporte"> <span>Soporte</span></label>
                <label class="multi-select-option"><input type="checkbox" value="lanzador"> <span>Lanzador (Blaster)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="gish"> <span>Gish (Marcial-Mágico)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="francotirador"> <span>Francotirador (Sniper)</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-score" data-placeholder="Puntuación: Todas" data-type="include">
              <button type="button" class="multi-select-btn">
                <span class="multi-select-label">Puntuación: Todas</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option"><input type="checkbox" value="tier-s"> <span>Tier S (≥ 75)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="tier-a"> <span>Tier A (65 – 74)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="tier-b"> <span>Tier B (55 – 64)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="tier-c"> <span>Tier C (45 – 54)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="tier-d"> <span>Tier D (35 – 44)</span></label>
                <label class="multi-select-option"><input type="checkbox" value="tier-f"> <span>Tier F (&lt; 35)</span></label>
              </div>
            </div>
          </div>
        </div>

        <!-- Exclusion Group -->
        <div class="drawer-section">
          <span class="drawer-title exclude-title">🚫 Excluir</span>
          <div class="drawer-grid">
            <div class="multi-select" id="rank-ms-exclude-system" data-placeholder="Excluir Sistema: Ninguno" data-type="exclude">
              <button type="button" class="multi-select-btn filter-exclude">
                <span class="multi-select-label">Excluir Sistema: Ninguno</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option is-exclude"><input type="checkbox" value="2014"> <span>2014</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="2024"> <span>2024 / 5.5e</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-exclude-class" data-placeholder="Excluir Clase: Ninguna" data-type="exclude">
              <button type="button" class="multi-select-btn filter-exclude">
                <span class="multi-select-label">Excluir Clase: Ninguna</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option is-exclude"><input type="checkbox" value="artificer"> <span>Artificer</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="barbarian"> <span>Barbarian</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="bard"> <span>Bard</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="cleric"> <span>Cleric</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="druid"> <span>Druid</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="fighter"> <span>Fighter</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="monk"> <span>Monk</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="paladin"> <span>Paladin</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="ranger"> <span>Ranger</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="rogue"> <span>Rogue</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="sorcerer"> <span>Sorcerer</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="warlock"> <span>Warlock</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="wizard"> <span>Wizard</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-exclude-role" data-placeholder="Excluir Rol: Ninguno" data-type="exclude">
              <button type="button" class="multi-select-btn filter-exclude">
                <span class="multi-select-label">Excluir Rol: Ninguno</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tanque"> <span>Tanque</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="atacante"> <span>Atacante (Striker)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="controlador"> <span>Controlador</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="soporte"> <span>Soporte</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="lanzador"> <span>Lanzador (Blaster)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="gish"> <span>Gish (Marcial-Mágico)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="francotirador"> <span>Francotirador (Sniper)</span></label>
              </div>
            </div>

            <div class="multi-select" id="rank-ms-exclude-score" data-placeholder="Excluir Puntuación: Ninguna" data-type="exclude">
              <button type="button" class="multi-select-btn filter-exclude">
                <span class="multi-select-label">Excluir Puntuación: Ninguna</span>
                <span class="multi-select-arrow">▼</span>
              </button>
              <div class="multi-select-popover hidden">
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-s"> <span>Tier S (≥ 75)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-a"> <span>Tier A (65 – 74)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-b"> <span>Tier B (55 – 64)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-c"> <span>Tier C (45 – 54)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-d"> <span>Tier D (35 – 44)</span></label>
                <label class="multi-select-option is-exclude"><input type="checkbox" value="tier-f"> <span>Tier F (&lt; 35)</span></label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Tags Bar -->
      <div id="rank-active-tags" class="active-tags-bar"></div>
    </div>

    <!-- Table -->
    <div class="rank-table-wrap">
      <table class="rank-table" id="rank-table" aria-label="Tabla de ranking de builds">
        <thead>
          <tr>
            <th class="col-chk" title="Seleccionar todo">
              <label class="chk-wrap" aria-label="Seleccionar todos">
                <input type="checkbox" id="chk-all" class="chk-native" />
                <span class="chk-box" aria-hidden="true"></span>
              </label>
            </th>
            <th class="col-rank">#</th>
            <th class="col-name sortable" data-col="name" data-type="str">
              Nombre <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-classes">Clases</th>
            <th class="col-sys">Sistema</th>
            <th class="col-stat sortable active desc" data-col="total" data-type="num">
              Total <span class="sort-icon" aria-hidden="true">↓</span>
            </th>
            <th class="col-stat sortable" data-col="dpr"     data-type="num" style="color:var(--dpr)">
              DPR <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-stat sortable" data-col="ehp"     data-type="num" style="color:var(--ehp)">
              EHP <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-stat sortable" data-col="control" data-type="num" style="color:var(--control)">
              Ctrl <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-stat sortable" data-col="support" data-type="num" style="color:var(--support)">
              Supp <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-stat sortable" data-col="utility" data-type="num" style="color:var(--utility)">
              Util <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
            <th class="col-stat sortable" data-col="complexity" data-type="num" style="color:var(--complexity)">
              Cmplx <span class="sort-icon" aria-hidden="true">⇅</span>
            </th>
          </tr>
        </thead>
        <tbody id="rank-body">
          {builds
            .slice()
            .sort((a, b) => b.total - a.total)
            .map((build, i) => (
              <tr
                class="rank-row"
                data-name={build.name.toLowerCase()}
                data-classes={build.classes.toLowerCase()}
                data-system={build.system}
                data-role={build.role.toLowerCase()}
                data-total={build.total}
                data-dpr={build.ratings.dpr}
                data-ehp={build.ratings.ehp}
                data-control={build.ratings.control}
                data-support={build.ratings.support}
                data-utility={build.ratings.utility}
                data-complexity={build.ratings.complexity}
                data-id={build.id}
              >
                <td class="col-chk">
                  <label class="chk-wrap" aria-label={`Seleccionar ${build.name}`}>
                    <input type="checkbox" class="chk-native row-chk" data-id={build.id} />
                    <span class="chk-box" aria-hidden="true"></span>
                  </label>
                </td>
                <td class="col-rank td-rank">{i + 1}</td>

                <td class="col-name td-name">
                  <a href={`${base}builds/${build.id}`} class="rank-link">
                    {build.name}
                  </a>
                </td>

                <td class="col-classes td-classes">{build.classes}</td>

                <td class="col-sys">
                  <span class={`card-system ${
                    build.system.includes('2024') && build.system.includes('2014') ? 'sboth'
                    : build.system.includes('2024') ? 's2024'
                    : 's2014'
                  }`} style="font-size:0.6rem">
                    {build.system.includes('2024') && build.system.includes('2014') ? '2014/24'
                     : build.system.includes('2024') ? '5.5e'
                     : '2014'}
                  </span>
                </td>

                <td class="col-stat td-total" data-val={build.total}>
                  <div class="rank-bar-cell">
                    <span class="rank-num" style="color:var(--gold)">{build.total}</span>
                    <div class="rank-bar-bg">
                      <div class="rank-bar-fill" style={`width:${build.total}%;background:var(--gold)`}></div>
                    </div>
                  </div>
                </td>

                {[
                  { val: build.ratings.dpr,        color: 'var(--dpr)'        },
                  { val: build.ratings.ehp,        color: 'var(--ehp)'        },
                  { val: build.ratings.control,    color: 'var(--control)'    },
                  { val: build.ratings.support,    color: 'var(--support)'    },
                  { val: build.ratings.utility,    color: 'var(--utility)'    },
                  { val: build.ratings.complexity, color: 'var(--complexity)' },
                ].map(s => (
                  <td class="col-stat" data-val={s.val}>
                    <div class="rank-bar-cell">
                      <span class="rank-num" style={`color:${s.color}`}>{s.val}</span>
                      <div class="rank-bar-bg">
                        <div class="rank-bar-fill" style={`width:${s.val}%;background:${s.color}`}></div>
                      </div>
                    </div>
                  </div>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="empty-state" id="rank-empty" style="display:none">
      No hay builds con ese criterio.
    </p>

    <!-- Glassmorphism compare FAB -->
    <div id="compare-fab" class="compare-fab" aria-live="polite" aria-label="Comparar builds seleccionadas">
      <div class="fab-glow"></div>
      <div class="fab-inner">
        <div class="fab-info">
          <span class="fab-sword" aria-hidden="true">⚔️</span>
          <span class="fab-label">
            <span id="fab-count" class="fab-count">0</span>
            <span class="fab-sub">builds para comparar</span>
          </span>
        </div>
        <div class="fab-actions">
          <button id="fab-compare-btn" class="fab-cta" disabled>
            Ver Comparativa
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="13" y2="8"/><polyline points="9 4 13 8 9 12"/></svg>
          </button>
          <button id="fab-clear-btn" class="fab-clear" title="Limpiar selección" aria-label="Limpiar selección">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- ─────────────────────────────────────────────────────────────── Styles -->
<style>
.rank-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem 5rem;
}

.rank-bar {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

/* Scrollable table container */
.rank-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--bg-card);
}

.rank-table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  min-width: 800px;
}

/* Header */
.rank-table thead tr {
  background: rgba(201,168,76,0.05);
  border-bottom: 1px solid var(--border-hover);
}
.rank-table th {
  padding: 0.75rem 0.875rem;
  text-align: left;
  font-weight: 700;
  color: var(--text-2);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  white-space: nowrap;
  user-select: none;
}
.rank-table th.sortable {
  cursor: pointer;
  transition: color var(--t);
}
.rank-table th.sortable:hover { color: var(--text); }
.rank-table th.active { color: var(--gold); }

.sort-icon {
  display: inline-block;
  margin-left: 3px;
  font-size: 0.65rem;
  opacity: 0.5;
}
th.active .sort-icon { opacity: 1; }

/* Rows */
.rank-table tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background var(--t);
}
.rank-table tbody tr:last-child { border-bottom: none; }
.rank-table tbody tr:hover { background: rgba(201,168,76,0.03); }

.rank-table td {
  padding: 0.5625rem 0.875rem;
  vertical-align: middle;
}

/* Column widths */
.col-chk    { width: 44px; text-align: center; padding-left: 0.75rem; }
.col-rank   { width: 36px; text-align: center; }
.col-name   { min-width: 160px; }
.col-classes{ min-width: 200px; color: var(--text-2); font-size: 0.75rem; }
.col-sys    { width: 72px; }
.col-stat   { width: 110px; }

/* ── Custom Checkbox ────────────────────────────────────────────────────── */
.chk-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  width: 20px;
  height: 20px;
  position: relative;
}
.chk-native {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.chk-box {
  width: 17px;
  height: 17px;
  border: 1.5px solid var(--border-hover);
  border-radius: 4px;
  background: var(--bg-surface);
  transition: border-color var(--t), background var(--t), box-shadow var(--t);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.chk-box::after {
  content: '';
  width: 4px;
  height: 8px;
  border-right: 2px solid #0e0e1c;
  border-bottom: 2px solid #0e0e1c;
  transform: rotate(45deg) translateY(-1px);
  opacity: 0;
  transition: opacity 120ms ease;
}
.chk-native:checked ~ .chk-box {
  background: var(--gold);
  border-color: var(--gold-bright);
  box-shadow: 0 0 8px rgba(201,168,76,0.5);
}
.chk-native:checked ~ .chk-box::after { opacity: 1; }
.chk-native:indeterminate ~ .chk-box {
  background: var(--bg-subtle);
  border-color: var(--gold);
}
.chk-native:indeterminate ~ .chk-box::after {
  height: 0;
  width: 8px;
  border-right: none;
  border-bottom: 2px solid var(--gold);
  transform: none;
  opacity: 1;
  margin-left: 1px;
}
.chk-wrap:hover .chk-box { border-color: var(--gold); }

/* ── Selected Row ───────────────────────────────────────────────────────── */
.rank-row {
  position: relative;
  transition: background var(--t), box-shadow var(--t);
}
.rank-row.row-selected {
  background: rgba(201,168,76,0.07) !important;
}
.rank-row.row-selected::after {
  content: '';
  position: absolute;
  inset: 0;
  border-left: 2px solid var(--gold);
  pointer-events: none;
}

/* ── Compare FAB ────────────────────────────────────────────────────────── */
.compare-fab {
  position: fixed;
  bottom: 2.25rem;
  left: 50%;
  transform: translateX(-50%) translateY(120%);
  z-index: 200;
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 250ms ease;
  opacity: 0;
  pointer-events: none;
}
.compare-fab.fab-visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.fab-glow {
  position: absolute;
  inset: -1px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(201,168,76,0.5), rgba(123,45,139,0.3));
  filter: blur(8px);
  z-index: -1;
}
.fab-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: rgba(17,17,34,0.85);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(201,168,76,0.35);
  border-radius: 14px;
  padding: 0.875rem 1rem 0.875rem 1.25rem;
  box-shadow:
    0 20px 60px rgba(0,0,0,0.7),
    0 0 0 1px rgba(201,168,76,0.08) inset;
  white-space: nowrap;
}
.fab-info {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}
.fab-sword { font-size: 1.25rem; line-height: 1; }
.fab-label {
  display: flex;
  flex-direction: column;
  gap: 0;
  line-height: 1.1;
}
.fab-count {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--gold-bright);
  letter-spacing: -0.02em;
}
.fab-sub {
  font-size: 0.7rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}
.fab-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.fab-cta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-bright) 100%);
  color: #0e0e1c;
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 0.8125rem;
  border: none;
  border-radius: 8px;
  padding: 0.55rem 1rem;
  cursor: pointer;
  transition: filter var(--t), transform 120ms ease;
  letter-spacing: 0.01em;
}
.fab-cta svg { width: 14px; height: 14px; flex-shrink: 0; }
.fab-cta:hover:not([disabled]) { filter: brightness(1.15); transform: translateY(-1px); }
.fab-cta:active:not([disabled]) { transform: translateY(0); }
.fab-cta[disabled] {
  opacity: 0.45;
  cursor: not-allowed;
  filter: none;
}
.fab-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text-muted);
  cursor: pointer;
  transition: background var(--t), color var(--t), border-color var(--t);
}
.fab-clear svg { width: 12px; height: 12px; }
.fab-clear:hover {
  background: rgba(239,68,68,0.12);
  border-color: rgba(239,68,68,0.4);
  color: #ef4444;
}

.td-rank {
  font-family: var(--font-display);
  font-size: 0.75rem;
  color: var(--text-muted);
  font-weight: 700;
}

/* Top 3 gold/silver/bronze */
.rank-row:nth-child(1) .td-rank { color: #fbbf24; }
.rank-row:nth-child(2) .td-rank { color: #9ca3af; }
.rank-row:nth-child(3) .td-rank { color: #b45309; }

.rank-link {
  color: var(--text);
  font-weight: 600;
  text-decoration: none;
  transition: color var(--t);
}
.rank-link:hover { color: var(--gold-bright); }

/* Mini bar inside cell */
.rank-bar-cell {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
</style>

<!-- ─────────────────────────────────────────────────────────────── Script -->
<script>
  const headers      = document.querySelectorAll<HTMLElement>('th.sortable');
  const tbody        = document.getElementById('rank-body')!;
  const search       = document.getElementById('rank-search') as HTMLInputElement;

  const sortBySelect = document.getElementById('rank-sort-by') as HTMLSelectElement;
  const sortDirBtn   = document.getElementById('rank-sort-dir') as HTMLButtonElement;
  const sortDirIcon  = document.getElementById('rank-sort-dir-icon') as HTMLElement;
  const sortDirText  = document.getElementById('rank-sort-dir-text') as HTMLElement;

  const btnToggleDrawer = document.getElementById('rank-btn-toggle-drawer') as HTMLButtonElement;
  const filterDrawer = document.getElementById('rank-filter-drawer') as HTMLElement;
  const badgeCount = document.getElementById('rank-filter-badge-count') as HTMLElement;
  const drawerArrow = document.getElementById('rank-drawer-arrow') as HTMLElement;

  const systemSelect = document.getElementById('rank-system') as HTMLSelectElement;
  const classSelect  = document.getElementById('rank-class') as HTMLSelectElement;
  const roleSelect   = document.getElementById('rank-role') as HTMLSelectElement;
  const scoreSelect  = document.getElementById('rank-score') as HTMLSelectElement;

  const exClassSelect  = document.getElementById('rank-exclude-class') as HTMLSelectElement;
  const exRoleSelect   = document.getElementById('rank-exclude-role') as HTMLSelectElement;
  const exSystemSelect = document.getElementById('rank-exclude-system') as HTMLSelectElement;

  const resetBtn     = document.getElementById('rank-btn-reset') as HTMLButtonElement;
  const activeTagsContainer = document.getElementById('rank-active-tags') as HTMLElement;

  const countEl      = document.getElementById('rank-count')!;
  const emptyEl      = document.getElementById('rank-empty')!;
  const fab          = document.getElementById('compare-fab')!;
  const fabCount     = document.getElementById('fab-count')!;
  const fabCta       = document.getElementById('fab-compare-btn') as HTMLButtonElement;
  const fabClear     = document.getElementById('fab-clear-btn')!;
  const chkAll       = document.getElementById('chk-all') as HTMLInputElement;

  let sortCol = 'total';
  let sortDir: 'asc' | 'desc' = 'desc';

  btnToggleDrawer?.addEventListener('click', () => {
    const isHidden = filterDrawer.classList.toggle('hidden');
    btnToggleDrawer.classList.toggle('active', !isHidden);
    btnToggleDrawer.setAttribute('aria-expanded', String(!isHidden));
    if (drawerArrow) drawerArrow.textContent = isHidden ? '▼' : '▲';
  });

  // Column key → td index (checkbox col adds 1)
  const COL_INDEX: Record<string, number> = {
    name: 2, dpr: 6, ehp: 7, control: 8, support: 9, utility: 10, complexity: 11, total: 5,
  };

  // ── Compare selection ────────────────────────────────────────────────────
  function getCheckedIds(): string[] {
    return [...document.querySelectorAll<HTMLInputElement>('.row-chk:checked')]
      .map(cb => cb.dataset.id ?? '').filter(Boolean);
  }

  function updateFab() {
    const ids = getCheckedIds();
    const n = ids.length;
    fabCount.textContent = String(n);
    fab.classList.toggle('fab-visible', n > 0);
    fabCta.disabled = n < 2;
    fabCta.title = n < 2 ? 'Selecciona al menos 2 builds' : '';

    // Sync master checkbox
    const allCbs = [...document.querySelectorAll<HTMLInputElement>('.rank-row:not([style*="display: none"]) .row-chk')];
    const checked = allCbs.filter(c => c.checked).length;
    chkAll.indeterminate = checked > 0 && checked < allCbs.length;
    chkAll.checked = allCbs.length > 0 && checked === allCbs.length;

    // Selected row highlight
    document.querySelectorAll<HTMLElement>('.rank-row').forEach(row => {
      const cb = row.querySelector<HTMLInputElement>('.row-chk');
      row.classList.toggle('row-selected', !!cb?.checked);
    });
  }

  // Checkbox change (delegated)
  tbody.addEventListener('change', e => {
    if ((e.target as HTMLElement).classList.contains('row-chk')) updateFab();
  });

  // Master checkbox
  chkAll.addEventListener('change', () => {
    document.querySelectorAll<HTMLInputElement>('.rank-row:not([style*="display: none"]) .row-chk')
      .forEach(cb => { cb.checked = chkAll.checked; });
    updateFab();
  });

  // Navigate to compare
  fabCta.addEventListener('click', () => {
    const ids = getCheckedIds();
    if (ids.length < 2) return;
    const parts = window.location.pathname.split('/');
    const idx = parts.indexOf('ranking');
    const base = idx > 0 ? parts.slice(0, idx).join('/') + '/' : '/';
    window.location.href = `${base}compare/?builds=${ids.join(',')}`;
  });

  // Clear selection
  fabClear.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.row-chk').forEach(cb => { cb.checked = false; });
    updateFab();
  });

  function getVal(row: HTMLElement, col: string): string | number {
    const idx = COL_INDEX[col];
    const td  = row.querySelectorAll('td')[idx];
    if (!td) return '';
    const dv = td.getAttribute('data-val');
    if (dv !== null) return Number(dv);
    return td.textContent?.trim().toLowerCase() ?? '';
  }

  function rerank() {
    const rows = [...tbody.querySelectorAll<HTMLElement>('.rank-row')].filter(
      r => r.style.display !== 'none'
    );
    let rank = 1;
    // Rows are already sorted — just update the rank column
    rows.forEach(row => {
      const rankCell = row.querySelector('.td-rank');
      if (rankCell) rankCell.textContent = String(rank++);
    });
  }

  function syncSortUI() {
    if (sortBySelect) sortBySelect.value = sortCol;
    if (sortDirIcon) sortDirIcon.textContent = sortDir === 'desc' ? '↓' : '↑';
    if (sortDirText) sortDirText.textContent = sortDir === 'desc' ? 'Desc' : 'Asc';
  }

  function sortTable() {
    const rows = [...tbody.querySelectorAll<HTMLElement>('.rank-row')];

    rows.sort((a, b) => {
      const va = getVal(a, sortCol);
      const vb = getVal(b, sortCol);
      let cmp = 0;
      if (typeof va === 'number' && typeof vb === 'number') {
        cmp = va - vb;
      } else {
        cmp = String(va).localeCompare(String(vb));
      }
      return sortDir === 'desc' ? -cmp : cmp;
    });

    rows.forEach(r => tbody.appendChild(r));

    // Update header icons
    headers.forEach(h => {
      const active = h.dataset.col === sortCol;
      h.classList.toggle('active', active);
      const icon = h.querySelector<HTMLElement>('.sort-icon');
      if (!icon) return;
      if (!active) { icon.textContent = '⇅'; return; }
      icon.textContent = sortDir === 'desc' ? '↓' : '↑';
    });

    syncSortUI();
    rerank();
  }

  // ── Multi-Select Helper Functions ─────────────────────────────────────────
  const RANK_MS_IDS = [
    'rank-ms-system', 'rank-ms-class', 'rank-ms-role', 'rank-ms-score',
    'rank-ms-exclude-system', 'rank-ms-exclude-class', 'rank-ms-exclude-role', 'rank-ms-exclude-score'
  ];

  function getSelectedValues(msId: string): string[] {
    const container = document.getElementById(msId);
    if (!container) return [];
    return [...container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map(cb => cb.value);
  }

  function setSelectedValues(msId: string, values: string[]) {
    const container = document.getElementById(msId);
    if (!container) return;
    const checkboxes = container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    checkboxes.forEach(cb => { cb.checked = values.includes(cb.value); });
    updateMultiSelectLabel(msId);
  }

  function unselectValue(msId: string, value: string) {
    const current = getSelectedValues(msId);
    setSelectedValues(msId, current.filter(v => v !== value));
  }

  function updateMultiSelectLabel(msId: string) {
    const container = document.getElementById(msId);
    if (!container) return;
    const btn = container.querySelector<HTMLButtonElement>('.multi-select-btn');
    const label = container.querySelector<HTMLElement>('.multi-select-label');
    const placeholder = container.dataset.placeholder || '';
    const isExclude = container.dataset.type === 'exclude';
    const checked = [...container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')];

    if (!btn || !label) return;

    if (checked.length === 0) {
      label.textContent = placeholder;
      btn.classList.remove('active');
      if (isExclude) btn.classList.remove('has-active-exclude');
    } else if (checked.length === 1) {
      const text = checked[0].nextElementSibling?.textContent || checked[0].value;
      const prefix = isExclude ? 'Excluir: ' : '';
      label.textContent = `${prefix}${text}`;
      btn.classList.add('active');
      if (isExclude) btn.classList.add('has-active-exclude');
    } else {
      const prefix = isExclude ? 'Excluir: ' : '';
      label.textContent = `${prefix}${checked.length} seleccionados`;
      btn.classList.add('active');
      if (isExclude) btn.classList.add('has-active-exclude');
    }
  }

  // Setup Multi-Select Event Delegation & Popover Toggling
  RANK_MS_IDS.forEach(msId => {
    const container = document.getElementById(msId);
    if (!container) return;
    const btn = container.querySelector<HTMLButtonElement>('.multi-select-btn');
    const popover = container.querySelector<HTMLElement>('.multi-select-popover');

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other popovers
      RANK_MS_IDS.forEach(otherId => {
        if (otherId !== msId) {
          document.getElementById(otherId)?.querySelector('.multi-select-popover')?.classList.add('hidden');
        }
      });
      popover?.classList.toggle('hidden');
    });

    container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', () => {
        updateMultiSelectLabel(msId);
        filterTable();
      });
    });
  });

  // Close popovers on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.multi-select')) {
      RANK_MS_IDS.forEach(msId => {
        document.getElementById(msId)?.querySelector('.multi-select-popover')?.classList.add('hidden');
      });
    }
  });

  function matchRoleFilter(roleText: string, filterVal: string) {
    const r = roleText.toLowerCase();
    const v = filterVal.toLowerCase();
    if (v === 'tanque' || v === 'tank') return r.includes('tanque') || r.includes('tank');
    if (v === 'atacante' || v === 'striker') return r.includes('atacante') || r.includes('striker');
    if (v === 'controlador' || v === 'controller') return r.includes('controlador') || r.includes('control') || r.includes('controller');
    if (v === 'soporte' || v === 'support') return r.includes('soporte') || r.includes('sanador') || r.includes('apoyo') || r.includes('support');
    if (v === 'lanzador' || v === 'blaster') return r.includes('lanzador') || r.includes('blaster');
    if (v === 'gish') return r.includes('gish');
    if (v === 'francotirador' || v === 'sniper') return r.includes('francotirador') || r.includes('sniper');
    return r.includes(v);
  }

  function matchScoreFilter(totalScore: number, filterVal: string): boolean {
    if (filterVal === 'tier-s') return totalScore >= 75;
    if (filterVal === 'tier-a') return totalScore >= 65 && totalScore < 75;
    if (filterVal === 'tier-b') return totalScore >= 55 && totalScore < 65;
    if (filterVal === 'tier-c') return totalScore >= 45 && totalScore < 55;
    if (filterVal === 'tier-d') return totalScore >= 35 && totalScore < 45;
    if (filterVal === 'tier-f') return totalScore < 35;
    return true;
  }

  function renderActiveTags() {
    if (!activeTagsContainer) return;
    activeTagsContainer.innerHTML = '';
    let countActive = 0;

    const addTag = (text: string, isExclude: boolean, clearFn: () => void) => {
      countActive++;
      const tag = document.createElement('span');
      tag.className = `tag-badge ${isExclude ? 'tag-badge-exclude' : 'tag-badge-include'}`;
      tag.textContent = text + ' ';
      const closeBtn = document.createElement('button');
      closeBtn.className = 'tag-close';
      closeBtn.textContent = '×';
      closeBtn.onclick = (e) => {
        e.preventDefault();
        clearFn();
        filterTable();
      };
      tag.appendChild(closeBtn);
      activeTagsContainer.appendChild(tag);
    };

    // System Includes
    getSelectedValues('rank-ms-system').forEach(v => {
      addTag(`Sistema: ${v}`, false, () => unselectValue('rank-ms-system', v));
    });

    // Class Includes
    getSelectedValues('rank-ms-class').forEach(v => {
      addTag(`Clase: ${v}`, false, () => unselectValue('rank-ms-class', v));
    });

    // Role Includes
    getSelectedValues('rank-ms-role').forEach(v => {
      addTag(`Rol: ${v}`, false, () => unselectValue('rank-ms-role', v));
    });

    // Score Includes
    getSelectedValues('rank-ms-score').forEach(v => {
      addTag(`Puntuación: ${v.toUpperCase()}`, false, () => unselectValue('rank-ms-score', v));
    });

    // Excludes
    getSelectedValues('rank-ms-exclude-system').forEach(v => {
      addTag(`Excluir Sistema: ${v}`, true, () => unselectValue('rank-ms-exclude-system', v));
    });

    getSelectedValues('rank-ms-exclude-class').forEach(v => {
      addTag(`Excluir Clase: ${v}`, true, () => unselectValue('rank-ms-exclude-class', v));
    });

    getSelectedValues('rank-ms-exclude-role').forEach(v => {
      addTag(`Excluir Rol: ${v}`, true, () => unselectValue('rank-ms-exclude-role', v));
    });

    getSelectedValues('rank-ms-exclude-score').forEach(v => {
      addTag(`Excluir Puntuación: ${v.toUpperCase()}`, true, () => unselectValue('rank-ms-exclude-score', v));
    });

    // Text Search Tokens
    const rawQuery = search?.value.trim() ?? '';
    if (rawQuery) {
      const tokens = rawQuery.split(/\s+/);
      tokens.forEach(token => {
        if (token.startsWith('-') && token.length > 1) {
          addTag(`Excluir: "${token.slice(1)}"`, true, () => {
            search.value = tokens.filter(t => t !== token).join(' ');
            filterTable();
          });
        } else if (token) {
          addTag(`Buscar: "${token}"`, false, () => {
            search.value = tokens.filter(t => t !== token).join(' ');
            filterTable();
          });
        }
      });
    }

    if (badgeCount) {
      badgeCount.textContent = String(countActive);
      badgeCount.style.display = countActive > 0 ? 'inline-block' : 'none';
    }

    if (resetBtn) {
      resetBtn.style.display = countActive > 0 ? 'inline-flex' : 'none';
    }
  }

  function filterTable() {
    const rawQuery = search?.value.toLowerCase().trim() ?? '';
    const sysVals   = getSelectedValues('rank-ms-system');
    const classVals = getSelectedValues('rank-ms-class');
    const roleVals  = getSelectedValues('rank-ms-role');
    const scoreVals = getSelectedValues('rank-ms-score');

    const exSysVals   = getSelectedValues('rank-ms-exclude-system');
    const exClassVals = getSelectedValues('rank-ms-exclude-class');
    const exRoleVals  = getSelectedValues('rank-ms-exclude-role');
    const exScoreVals = getSelectedValues('rank-ms-exclude-score');

    const tokens = rawQuery ? rawQuery.split(/\s+/).filter(Boolean) : [];
    const includeTokens = tokens.filter(t => !t.startsWith('-'));
    const excludeTokens = tokens.filter(t => t.startsWith('-') && t.length > 1).map(t => t.slice(1));

    const rows = document.querySelectorAll<HTMLElement>('.rank-row');
    let visible = 0;

    rows.forEach(row => {
      const sys = row.dataset.system ?? '';
      const name = row.dataset.name ?? '';
      const classes = row.dataset.classes ?? '';
      const role = row.dataset.role ?? '';
      const total = Number(row.dataset.total ?? '0');

      // Include checks (Multi-select OR logic)
      const matchSys   = sysVals.length === 0 || sysVals.some(v => sys.includes(v));
      const matchClass = classVals.length === 0 || classVals.some(v => classes.includes(v));
      const matchRole  = roleVals.length === 0 || roleVals.some(v => matchRoleFilter(role, v));
      const matchScore = scoreVals.length === 0 || scoreVals.some(v => matchScoreFilter(total, v));

      // Search text include
      const rowText = `${name} ${classes} ${role} ${sys}`.toLowerCase();
      const matchSearchInclude = includeTokens.every(token => rowText.includes(token));

      // Explicit Exclude checks (Multi-select AND NOT logic)
      const matchExSys   = exSysVals.length === 0 || !exSysVals.some(v => sys.includes(v));
      const matchExClass = exClassVals.length === 0 || !exClassVals.some(v => classes.includes(v));
      const matchExRole  = exRoleVals.length === 0 || !exRoleVals.some(v => matchRoleFilter(role, v));
      const matchExScore = exScoreVals.length === 0 || !exScoreVals.some(v => matchScoreFilter(total, v));

      // Search text exclude
      const matchSearchExclude = excludeTokens.every(token => !rowText.includes(token));

      const show = matchSys && matchClass && matchRole && matchScore &&
                   matchExSys && matchExClass && matchExRole && matchExScore &&
                   matchSearchInclude && matchSearchExclude;

      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countEl.textContent = String(visible);
    emptyEl.style.display = visible === 0 ? '' : 'none';
    rerank();
    updateFab();
    renderActiveTags();
  }

  headers.forEach(h => {
    h.addEventListener('click', () => {
      const col = h.dataset.col!;
      if (col === sortCol) {
        sortDir = sortDir === 'desc' ? 'asc' : 'desc';
      } else {
        sortCol = col;
        sortDir = h.dataset.type === 'num' ? 'desc' : 'asc';
      }
      sortTable();
    });
  });

  sortBySelect?.addEventListener('change', () => {
    sortCol = sortBySelect.value;
    sortTable();
  });

  sortDirBtn?.addEventListener('click', () => {
    sortDir = sortDir === 'desc' ? 'asc' : 'desc';
    sortTable();
  });

  search?.addEventListener('input', filterTable);

  resetBtn?.addEventListener('click', () => {
    if (search) search.value = '';
    sortCol = 'total';
    sortDir = 'desc';

    RANK_MS_IDS.forEach(msId => setSelectedValues(msId, []));

    sortTable();
    filterTable();
  });

  // Initial setup
  syncSortUI();
  filterTable();
</script>
