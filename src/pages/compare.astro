---
import Layout from '../layouts/Layout.astro';
import RadarChart from '../components/RadarChart.astro';
import ComparisonRadar from '../components/ComparisonRadar.astro';
import buildsData from '../../builds.json';

const base = import.meta.env.BASE_URL;

// Calculate total ratings for builds
const builds = buildsData.map(b => {
  const r = b.ratings;
  const total = roundScore((r.dpr + r.ehp + r.control + r.support + r.utility + r.complexity) / 6);
  return { ...b, total };
});

function roundScore(n: number) {
  return Math.round(n * 10) / 10;
}

const statConfigs = [
  { key: 'dpr',        label: 'Daño (DPR)',   color: 'var(--dpr)'        },
  { key: 'ehp',        label: 'Aguante (EHP)',color: 'var(--ehp)'        },
  { key: 'control',    label: 'Control',      color: 'var(--control)'    },
  { key: 'support',    label: 'Soporte',      color: 'var(--support)'    },
  { key: 'utility',    label: 'Utilidad',     color: 'var(--utility)'    },
  { key: 'complexity', label: 'Complejidad',  color: 'var(--complexity)' },
];
---

<Layout title="Comparativa Modular de Personajes" description="Compara cara a cara de forma modular ilimitada las métricas, radares y capacidades tácticas de los personajes de D&D.">
  <div class="compare-page">
    <div class="hero">
      <h1 class="hero-title">Comparador Modular</h1>
      <p class="hero-subtitle">
        Selecciona cualquier número de personajes para analizar sus radares individuales, estadísticas superpuestas y matrices frente a frente.
      </p>
    </div>

    <div class="compare-wrap">
      <!-- Modular Selection Header -->
      <div class="compare-selection-bar">
        <div class="compare-bar-header">
          <span class="compare-bar-title">Personajes Seleccionados:</span>
          <div class="compare-quick-actions">
            <button id="btn-quick-top4" type="button" class="btn-subtle">Top 4 META</button>
            <button id="btn-clear-all" type="button" class="btn-subtle text-danger">Limpiar Todo</button>
          </div>
        </div>

        <!-- Chips container -->
        <div class="compare-chips-container" id="compare-chips-container">
          <!-- Rendered dynamically by JS -->
        </div>

        <!-- Add character select box -->
        <div class="compare-add-box">
          <label for="add-character-select" class="sr-only">Añadir personaje</label>
          <select id="add-character-select" class="filter-select compare-add-select">
            <option value="none">➕ Añadir personaje a la comparativa…</option>
            {builds.map(b => (
              <option value={b.id}>
                {b.name} ({b.total} Pts) — {b.classes}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- View Mode Switcher Tabs -->
      <div class="compare-view-tabs" role="tablist">
        <button id="tab-cards" class="compare-tab-btn active" data-view="cards" role="tab">
          <span>🌟</span> Tarjetas Modulares (Radares Individuales)
        </button>
        <button id="tab-overlay" class="compare-tab-btn" data-view="overlay" role="tab">
          <span>🕸️</span> Radar Superpuesto
        </button>
        <button id="tab-matrix" class="compare-tab-btn" data-view="matrix" role="tab">
          <span>📋</span> Matriz Comparativa
        </button>
      </div>

      <!-- Content Area for Views -->
      <div id="compare-view-container" class="compare-view-container">

        <!-- VIEW 1: Modular Cards (Individual Radars & Stats) -->
        <div id="view-cards" class="compare-view-pane active">
          <div class="modular-cards-grid" id="modular-cards-grid">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- VIEW 2: Overlaid Radar -->
        <div id="view-overlay" class="compare-view-pane">
          <div class="compare-card-panel">
            <h2 class="compare-panel-title">Gráfico de Radar Multicapa Superpuesto</h2>
            <div id="overlay-radar-mount">
              <!-- Rendered by JS -->
            </div>
          </div>
        </div>

        <!-- VIEW 3: Side-by-Side Matrix Table -->
        <div id="view-matrix" class="compare-view-pane">
          <div class="compare-card-panel">
            <h2 class="compare-panel-title">Matriz Lado a Lado con Líder de Categóría (👑)</h2>
            <div class="matrix-table-wrap" id="matrix-table-wrap">
              <!-- Rendered by JS -->
            </div>
          </div>
        </div>

      </div>

      <!-- Empty State -->
      <div id="compare-empty-state" class="empty-state" style="display:none">
        <p class="empty-title">Sin personajes seleccionados</p>
        <p class="empty-sub">Selecciona al menos 2 personajes desde la barra superior o el catálogo para ver la comparativa.</p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ builds, base, statConfigs }}>
  // Parse initial build IDs from URL or LocalStorage
  const urlParams = new URLSearchParams(window.location.search);
  const paramBuilds = urlParams.get('builds')?.split(',').filter(Boolean) || [];

  let selectedIds = paramBuilds;

  if (selectedIds.length === 0) {
    try {
      const stored = JSON.parse(localStorage.getItem('dnd_compare_builds') || '[]');
      if (Array.isArray(stored) && stored.length > 0) {
        selectedIds = stored;
      }
    } catch(e) {}
  }

  // Fallback defaults if still empty
  if (selectedIds.length < 2) {
    selectedIds = ['tempest-demiurge', 'clocklock'];
  }

  let activeView = 'cards'; // 'cards' | 'overlay' | 'matrix'

  function getActiveBuilds() {
    return selectedIds
      .map(id => builds.find(b => b.id === id))
      .filter(Boolean);
  }

  function saveState() {
    const activeBuilds = getActiveBuilds();
    const ids = activeBuilds.map(b => b.id);
    
    // Update URL
    const newUrl = ids.length > 0
      ? `${window.location.pathname}?builds=${ids.join(',')}`
      : window.location.pathname;
    window.history.replaceState(null, '', newUrl);

    // Save to localStorage
    try {
      localStorage.setItem('dnd_compare_builds', JSON.stringify(ids));
    } catch(e) {}
  }

  function renderChips() {
    const container = document.getElementById('compare-chips-container');
    const activeBuilds = getActiveBuilds();

    if (!container) return;

    if (activeBuilds.length === 0) {
      container.innerHTML = '<span class="text-muted" style="font-size:0.8125rem">No hay personajes seleccionados.</span>';
      return;
    }

    container.innerHTML = activeBuilds.map(b => `
      <div class="compare-chip">
        <span class="compare-chip-name">${b.name}</span>
        <span class="compare-chip-score">${b.total}</span>
        <button type="button" class="compare-chip-remove" data-remove="${b.id}" title="Quitar ${b.name}">✕</button>
      </div>
    `).join('');

    // Attach remove handlers
    container.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idToRemove = btn.getAttribute('data-remove');
        selectedIds = selectedIds.filter(id => id !== idToRemove);
        saveState();
        renderAll();
      });
    });
  }

  function renderViewCards(activeBuilds) {
    const grid = document.getElementById('modular-cards-grid');
    if (!grid) return;

    grid.innerHTML = activeBuilds.map(b => `
      <div class="modular-build-card">
        <div class="modular-card-header">
          <span class="card-system ${
            b.system.includes('2024') && b.system.includes('2014') ? 'sboth'
            : b.system.includes('2024') ? 's2024' : 's2014'
          }">
            ${b.system.includes('2024') && b.system.includes('2014') ? '2014/24' : b.system.includes('2024') ? '5.5e' : '2014'}
          </span>
          <div class="modular-card-score">
            <span class="modular-score-num">${b.total}</span>
            <span class="modular-score-lbl">TOTAL</span>
          </div>
        </div>

        <div class="modular-card-info">
          <a href="${base}builds/${b.id}" class="modular-card-title">${b.name}</a>
          <p class="modular-card-classes">${b.classes}</p>
          <p class="modular-card-role">${b.role}</p>
        </div>

        <!-- Mini Radar SVG with 240x240 viewBox & Generous Clearances -->
        <div class="modular-card-radar">
          <svg viewBox="0 0 240 240" class="mini-radar-svg" role="img" aria-label="Radar individual">
            <!-- Rings -->
            <polygon points="120,45 185,82.5 185,157.5 120,195 55,157.5 55,82.5" fill="none" stroke="rgba(201,168,76,0.3)" stroke-width="1.2" />
            <polygon points="120,70 163.3,95 163.3,145 120,170 76.7,145 76.7,95" fill="none" stroke="rgba(201,168,76,0.15)" stroke-width="0.7" />
            <polygon points="120,95 141.6,107.5 141.6,132.5 120,145 98.4,132.5 98.4,107.5" fill="none" stroke="rgba(201,168,76,0.1)" stroke-width="0.5" />
            
            <!-- Axis lines -->
            <line x1="120" y1="120" x2="120" y2="45" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />
            <line x1="120" y1="120" x2="185" y2="82.5" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />
            <line x1="120" y1="120" x2="185" y2="157.5" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />
            <line x1="120" y1="120" x2="120" y2="195" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />
            <line x1="120" y1="120" x2="55" y2="157.5" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />
            <line x1="120" y1="120" x2="55" y2="82.5" stroke="rgba(201,168,76,0.2)" stroke-width="0.8" />

            <!-- Stat polygon -->
            <polygon points="
              ${120},${120 - 75 * (b.ratings.dpr/100)}
              ${120 + 65 * (b.ratings.ehp/100)},${120 - 37.5 * (b.ratings.ehp/100)}
              ${120 + 65 * (b.ratings.control/100)},${120 + 37.5 * (b.ratings.control/100)}
              ${120},${120 + 75 * (b.ratings.support/100)}
              ${120 - 65 * (b.ratings.utility/100)},${120 + 37.5 * (b.ratings.utility/100)}
              ${120 - 65 * (b.ratings.complexity/100)},${120 - 37.5 * (b.ratings.complexity/100)}
            " fill="rgba(201,168,76,0.22)" stroke="var(--gold-bright)" stroke-width="2.2" stroke-linejoin="round" />

            <!-- Axis Labels with Generous Margin -->
            <text x="120" y="24" text-anchor="middle" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#ef4444">Daño</text>
            <text x="196" y="82.5" text-anchor="start" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#14b8a6">Aguante</text>
            <text x="196" y="157.5" text-anchor="start" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#a855f7">Control</text>
            <text x="120" y="216" text-anchor="middle" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#3b82f6">Soporte</text>
            <text x="44" y="157.5" text-anchor="end" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#10b981">Utilidad</text>
            <text x="44" y="82.5" text-anchor="end" font-size="11" font-family="Inter,sans-serif" font-weight="800" fill="#f59e0b">Cmplx</text>
          </svg>
        </div>

        <!-- Metric Bars Card Box -->
        <div class="modular-card-stats">
          ${[
            { key: 'dpr', label: 'Daño', color: 'var(--dpr)' },
            { key: 'ehp', label: 'Aguante', color: 'var(--ehp)' },
            { key: 'control', label: 'Control', color: 'var(--control)' },
            { key: 'support', label: 'Soporte', color: 'var(--support)' },
            { key: 'utility', label: 'Utilidad', color: 'var(--utility)' },
            { key: 'complexity', label: 'Complejidad', color: 'var(--complexity)' },
          ].map(s => {
            const val = b.ratings[s.key] || 0;
            return `
              <div class="modular-stat-row">
                <span class="modular-stat-lbl" style="color:${s.color}">${s.label}</span>
                <div class="modular-stat-bar">
                  <div class="modular-stat-fill" style="width:${val}%;background:${s.color}"></div>
                </div>
                <span class="modular-stat-val" style="color:${s.color}">${val}</span>
              </div>
            `;
          }).join('')}
        </div>

        <a href="${base}builds/${b.id}" class="modular-card-btn">Ver Guía Completa ➔</a>
      </div>
    `).join('');
  }

  function renderViewOverlay(activeBuilds) {
    const mount = document.getElementById('overlay-radar-mount');
    if (!mount) return;

    if (activeBuilds.length === 0) {
      mount.innerHTML = '<p class="text-muted">Selecciona al menos 1 personaje.</p>';
      return;
    }

    const PALETTE = ['#c9a84c', '#14b8a6', '#a855f7', '#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#06b6d4', '#8b5cf6'];
    const cx = 150, cy = 150, R = 100;
    const PI = Math.PI;
    const angles = Array.from({ length: 6 }, (_, i) => -PI / 2 + (i * 2 * PI) / 6);

    const labels = [
      { key: 'dpr', label: 'Daño', color: '#ef4444' },
      { key: 'ehp', label: 'Aguante', color: '#14b8a6' },
      { key: 'control', label: 'Control', color: '#a855f7' },
      { key: 'support', label: 'Soporte', color: '#3b82f6' },
      { key: 'utility', label: 'Utilidad', color: '#10b981' },
      { key: 'complexity', label: 'Complejidad', color: '#f59e0b' },
    ];

    function pt(r, i) {
      return {
        x: +(cx + r * Math.cos(angles[i])).toFixed(2),
        y: +(cy + r * Math.sin(angles[i])).toFixed(2),
      };
    }

    function polygon(r) {
      return angles.map((_, i) => { const p = pt(r, i); return `${p.x},${p.y}`; }).join(' ');
    }

    const buildPolys = activeBuilds.map((b, bi) => {
      const color = PALETTE[bi % PALETTE.length];
      const pts = [
        pt(R * (b.ratings.dpr / 100), 0),
        pt(R * (b.ratings.ehp / 100), 1),
        pt(R * (b.ratings.control / 100), 2),
        pt(R * (b.ratings.support / 100), 3),
        pt(R * (b.ratings.utility / 100), 4),
        pt(R * (b.ratings.complexity / 100), 5),
      ];
      return {
        color,
        pointsStr: pts.map(p => `${p.x},${p.y}`).join(' '),
        dots: pts,
        name: b.name
      };
    });

    const labelPts = angles.map((_, i) => pt(R + 20, i));

    mount.innerHTML = `
      <div class="overlay-radar-wrap">
        <svg viewBox="0 0 300 300" class="overlay-svg">
          ${[0.25, 0.5, 0.75, 1].map((f, li) => `
            <polygon points="${polygon(R * f)}" fill="none" stroke="${li === 3 ? 'rgba(201,168,76,0.35)' : 'rgba(201,168,76,0.12)'}" stroke-width="${li === 3 ? '1.2' : '0.6'}" />
          `).join('')}

          ${angles.map((_, i) => {
            const end = pt(R, i);
            return `<line x1="${cx}" y1="${cy}" x2="${end.x}" y2="${end.y}" stroke="rgba(201,168,76,0.2)" stroke-width="0.6" />`;
          }).join('')}

          ${buildPolys.map(bp => `
            <polygon points="${bp.pointsStr}" fill="${bp.color}22" stroke="${bp.color}" stroke-width="2" stroke-linejoin="round" />
            ${bp.dots.map(d => `<circle cx="${d.x}" cy="${d.y}" r="3.5" fill="${bp.color}" stroke="#0e0e1c" stroke-width="1" />`).join('')}
          `).join('')}

          ${labelPts.map((p, i) => `
            <text x="${p.x}" y="${p.y}" text-anchor="${p.x < cx - 5 ? 'end' : p.x > cx + 5 ? 'start' : 'middle'}" dominant-baseline="middle" font-size="9" font-family="Inter,sans-serif" font-weight="700" fill="${labels[i].color}">${labels[i].label}</text>
          `).join('')}
        </svg>

        <div class="overlay-legend-grid">
          ${buildPolys.map(bp => `
            <div class="overlay-legend-chip">
              <span class="overlay-dot" style="background:${bp.color}"></span>
              <span class="overlay-chip-name">${bp.name}</span>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  function renderViewMatrix(activeBuilds) {
    const wrap = document.getElementById('matrix-table-wrap');
    if (!wrap) return;

    if (activeBuilds.length === 0) {
      wrap.innerHTML = '<p class="text-muted">Selecciona personajes para ver la matriz.</p>';
      return;
    }

    wrap.innerHTML = `
      <table class="compare-matrix-table">
        <thead>
          <tr>
            <th class="col-metric">Métrica</th>
            ${activeBuilds.map(b => `
              <th class="col-build">
                <a href="${base}builds/${b.id}" class="matrix-build-name">${b.name}</a>
                <span class="matrix-build-classes">${b.classes}</span>
              </th>
            `).join('')}
          </tr>
        </thead>
        <tbody>
          <tr class="row-total">
            <td class="col-metric font-bold">Puntuación Total</td>
            ${activeBuilds.map(b => `<td class="col-build font-bold text-gold">${b.total} Pts</td>`).join('')}
          </tr>
          ${statConfigs.map(s => {
            const maxVal = Math.max(...activeBuilds.map(b => b.ratings[s.key] || 0));
            return `
              <tr>
                <td class="col-metric" style="color:${s.color}">${s.label}</td>
                ${activeBuilds.map(b => {
                  const val = b.ratings[s.key] || 0;
                  const isLeader = val === maxVal && maxVal > 0;
                  return `
                    <td class="col-build ${isLeader ? 'leader-cell' : ''}">
                      <span class="matrix-val" style="color:${s.color}">${val}</span>
                      ${isLeader ? '<span class="matrix-crown" title="Líder en esta métrica">👑</span>' : ''}
                    </td>
                  `;
                }).join('')}
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  function renderAll() {
    renderChips();
    const activeBuilds = getActiveBuilds();

    const container = document.getElementById('compare-view-container');
    const emptyState = document.getElementById('compare-empty-state');

    if (activeBuilds.length === 0) {
      if (container) container.style.display = 'none';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (container) container.style.display = 'block';
    if (emptyState) emptyState.style.display = 'none';

    renderViewCards(activeBuilds);
    renderViewOverlay(activeBuilds);
    renderViewMatrix(activeBuilds);

    // Update select dropdown options (disable already selected builds)
    const addSelect = document.getElementById('add-character-select');
    if (addSelect) {
      addSelect.value = 'none';
      Array.from(addSelect.options).forEach(opt => {
        if (opt.value !== 'none') {
          opt.disabled = selectedIds.includes(opt.value);
        }
      });
    }
  }

  // Handle Add Character select
  const addSelect = document.getElementById('add-character-select');
  addSelect?.addEventListener('change', () => {
    const val = addSelect.value;
    if (val && val !== 'none' && !selectedIds.includes(val)) {
      selectedIds.push(val);
      saveState();
      renderAll();
    }
  });

  // Handle Quick Actions
  document.getElementById('btn-quick-top4')?.addEventListener('click', () => {
    // Top 4 builds by score: tempest-demiurge, clocklock, iron-dancer, spirit-caller
    selectedIds = ['tempest-demiurge', 'clocklock', 'iron-dancer', 'spirit-caller'];
    saveState();
    renderAll();
  });

  document.getElementById('btn-clear-all')?.addEventListener('click', () => {
    selectedIds = [];
    saveState();
    renderAll();
  });

  // Handle View Tabs
  const tabBtns = document.querySelectorAll('.compare-tab-btn');
  const viewPanes = document.querySelectorAll('.compare-view-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-view');
      if (!view) return;

      tabBtns.forEach(b => b.classList.toggle('active', b === btn));
      viewPanes.forEach(pane => {
        pane.classList.toggle('active', pane.id === `view-${view}`);
      });
    });
  });

  // Initial render
  renderAll();
</script>

<style is:global>
.compare-page {
  min-height: 100vh;
}

.compare-wrap {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 2rem 5rem;
}

/* Selection Bar */
.compare-selection-bar {
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 1.25rem;
  margin-bottom: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.compare-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.compare-bar-title {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.compare-quick-actions {
  display: flex;
  gap: 0.5rem;
}

.btn-subtle {
  font-size: 0.75rem;
  font-family: var(--font-ui);
  padding: 0.25rem 0.6rem;
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  color: var(--text-2);
  transition: all var(--t);
  cursor: pointer;
}
.btn-subtle:hover {
  color: var(--text);
  border-color: var(--border-hover);
}
.btn-subtle.text-danger:hover {
  color: #fc8181;
  border-color: rgba(239, 68, 68, 0.4);
}

/* Chips */
.compare-chips-container {
  display: flex;
  flex-wrap: wrap;
  gap: 0.625rem;
  align-items: center;
}

.compare-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(201, 168, 76, 0.1);
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 0.35rem 0.85rem;
  font-size: 0.8125rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  animation: fadeIn 200ms ease;
}

.compare-chip-name {
  font-weight: 700;
  color: var(--gold-bright);
}

.compare-chip-score {
  font-size: 0.725rem;
  font-weight: 800;
  background: var(--gold);
  color: var(--bg-deep);
  padding: 0.1rem 0.45rem;
  border-radius: 999px;
}

.compare-chip-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.5);
  color: #fc8181;
  font-size: 0.7rem;
  font-weight: 800;
  line-height: 1;
  cursor: pointer;
  transition: all var(--t);
