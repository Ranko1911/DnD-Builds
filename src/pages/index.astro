---
import Layout from '../layouts/Layout.astro';
import BuildCard from '../components/BuildCard.astro';
import buildsData from '../../builds.json';

const builds = buildsData.map(b => ({
  ...b,
  total: Math.round((b.ratings.dpr + b.ratings.ehp + b.ratings.control + b.ratings.support + b.ratings.utility) / 5)
}));

const counts = {
  all: builds.length,
  y2014: builds.filter(b => b.system.includes('2014')).length,
  y2024: builds.filter(b => b.system.includes('2024')).length,
};
---

<Layout title="Compendio de Builds">
  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <h1 class="hero-title">D&amp;D Builds</h1>
    <p class="hero-subtitle">
      Compendio de personajes optimizados para D&amp;D 5e,<br />
      analizados por el Archivero del Multiverso.
    </p>
    <span class="hero-count">
      <strong>{counts.all}</strong> builds catalogadas
    </span>
  </section>

  <!-- ── Filters ─────────────────────────────────────────────────────────── -->
  <div class="filters">
    <div class="search-wrap">
      <svg class="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        id="build-search"
        type="search"
        class="search-input"
        placeholder="Buscar por nombre, clase, rol…"
        aria-label="Buscar builds"
        autocomplete="off"
      />
    </div>

    <div class="filter-item">
      <select id="filter-system" class="filter-select" aria-label="Filtrar por sistema">
        <option value="all">Sistema: Todos ({counts.all})</option>
        <option value="2014">2014 ({counts.y2014})</option>
        <option value="2024">2024 / 5.5e ({counts.y2024})</option>
      </select>
    </div>

    <div class="filter-item">
      <select id="filter-class" class="filter-select" aria-label="Filtrar por clase">
        <option value="all">Clase: Todas</option>
        <option value="artificer">Artificer (Artífice)</option>
        <option value="barbarian">Barbarian (Bárbaro)</option>
        <option value="bard">Bard (Bardo)</option>
        <option value="cleric">Cleric (Clérigo)</option>
        <option value="druid">Druid (Druida)</option>
        <option value="fighter">Fighter (Guerrero)</option>
        <option value="monk">Monk (Monje)</option>
        <option value="paladin">Paladin (Paladín)</option>
        <option value="ranger">Ranger (Explorador)</option>
        <option value="rogue">Rogue (Pícaro)</option>
        <option value="sorcerer">Sorcerer (Hechicero)</option>
        <option value="warlock">Warlock (Brujo)</option>
        <option value="wizard">Wizard (Mago)</option>
      </select>
    </div>

    <div class="filter-item">
      <select id="filter-role" class="filter-select" aria-label="Filtrar por rol">
        <option value="all">Rol: Todos</option>
        <option value="tank">Tank / Tanque</option>
        <option value="striker">Striker / Daño</option>
        <option value="controller">Controller / Control</option>
        <option value="support">Support / Apoyo</option>
        <option value="blaster">Blaster / Áreas</option>
        <option value="gish">Gish / Marcial-Mágico</option>
        <option value="sniper">Sniper / Distancia</option>
      </select>
    </div>

    <div class="filter-item">
      <select id="filter-score" class="filter-select" aria-label="Filtrar por puntuación total">
        <option value="all">Puntuación: Todas</option>
        <option value="tier-s">Tier S (≥ 75)</option>
        <option value="tier-a">Tier A (60 - 74)</option>
        <option value="tier-b">Tier B (&lt; 60)</option>
      </select>
    </div>
  </div>

  <!-- ── Grid ────────────────────────────────────────────────────────────── -->
  <div class="builds-grid" id="builds-grid">
    {builds.map(build => (
      <div
        data-card
        data-system={build.system}
        data-name={build.name.toLowerCase()}
        data-classes={build.classes.toLowerCase()}
        data-role={build.role.toLowerCase()}
        data-total={build.total}
      >
        <BuildCard build={build} />
      </div>
    ))}
    <p class="empty-state" id="no-results" style="display:none">
      No se encontraron builds con ese criterio.
    </p>
  </div>
</Layout>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-card]');
  const searchInput = document.getElementById('build-search') as HTMLInputElement;
  const systemSelect = document.getElementById('filter-system') as HTMLSelectElement;
  const classSelect = document.getElementById('filter-class') as HTMLSelectElement;
  const roleSelect = document.getElementById('filter-role') as HTMLSelectElement;
  const scoreSelect = document.getElementById('filter-score') as HTMLSelectElement;
  const noResults = document.getElementById('no-results')!;

  function applyFilters() {
    const query = searchInput?.value.toLowerCase().trim() ?? '';
    const sysVal = systemSelect?.value ?? 'all';
    const classVal = classSelect?.value ?? 'all';
    const roleVal = roleSelect?.value ?? 'all';
    const scoreVal = scoreSelect?.value ?? 'all';

    let visible = 0;
    cards.forEach(card => {
      const sys = card.dataset.system ?? '';
      const name = card.dataset.name ?? '';
      const classes = card.dataset.classes ?? '';
      const role = card.dataset.role ?? '';
      const total = Number(card.dataset.total ?? '0');

      const matchSys = sysVal === 'all' || sys.includes(sysVal);
      const matchClass = classVal === 'all' || classes.includes(classVal);
      const matchRole = roleVal === 'all' || role.includes(roleVal);

      let matchScore = true;
      if (scoreVal === 'tier-s') matchScore = total >= 75;
      else if (scoreVal === 'tier-a') matchScore = total >= 60 && total < 75;
      else if (scoreVal === 'tier-b') matchScore = total < 60;

      const matchSearch = !query ||
        name.includes(query) || classes.includes(query) || role.includes(query);

      const show = matchSys && matchClass && matchRole && matchScore && matchSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    noResults.style.display = visible === 0 ? '' : 'none';
  }

  searchInput?.addEventListener('input', applyFilters);
  systemSelect?.addEventListener('change', applyFilters);
  classSelect?.addEventListener('change', applyFilters);
  roleSelect?.addEventListener('change', applyFilters);
  scoreSelect?.addEventListener('change', applyFilters);
</script>
