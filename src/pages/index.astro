---
import Layout from '../layouts/Layout.astro';
import BuildCard from '../components/BuildCard.astro';
import buildsData from '../../builds.json';

const base = import.meta.env.BASE_URL;

const builds = buildsData.map(b => ({
  ...b,
  total: Math.round((b.ratings.dpr + b.ratings.ehp + b.ratings.control + b.ratings.support + b.ratings.utility) / 5)
}));

const counts = {
  all: builds.length,
  y2014: builds.filter(b => b.system.includes('2014')).length,
  y2024: builds.filter(b => b.system.includes('2024')).length,
};
---

<Layout title="Compendio de Builds">
  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <h1 class="hero-title">D&amp;D Builds</h1>
    <p class="hero-subtitle">
      Compendio de personajes optimizados para D&amp;D 5e,<br />
      analizados por el Archivero del Multiverso.
    </p>
    <span class="hero-count">
      <strong>{counts.all}</strong> builds catalogadas
    </span>
  </section>

  <!-- ── Filters ─────────────────────────────────────────────────────────── -->
  <div class="filter-panel">
    <div class="filter-main-bar">
      <div class="search-wrap">
        <svg class="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="build-search"
          type="search"
          class="search-input"
          placeholder="Buscar... (ej: -wizard o -2014 para excluir)"
          aria-label="Buscar builds"
          autocomplete="off"
        />
      </div>

      <!-- Sorter -->
      <div class="filter-item">
        <select id="sort-by" class="filter-select filter-sort" aria-label="Ordenar por">
          <option value="total">Ordenar: Puntuación Total</option>
          <option value="dpr">Ordenar: DPR</option>
          <option value="ehp">Ordenar: EHP</option>
          <option value="control">Ordenar: Control</option>
          <option value="support">Ordenar: Soporte</option>
          <option value="utility">Ordenar: Utilidad</option>
          <option value="complexity">Ordenar: Complejidad</option>
          <option value="name">Ordenar: Nombre</option>
        </select>
        <button id="sort-dir" type="button" class="btn-sort-dir" title="Cambiar dirección de orden (Descendente/Ascendente)" aria-label="Dirección de orden">
          <span id="sort-dir-icon">↓</span> <span id="sort-dir-text">Desc</span>
        </button>
      </div>

      <!-- Toggle Drawer Button -->
      <button id="btn-toggle-drawer" type="button" class="btn-toggle-filters" aria-expanded="false">
        <span>🎛️ Filtros &amp; Exclusiones</span>
        <span id="filter-badge-count" class="badge-count" style="display:none">0</span>
        <span id="drawer-arrow">▼</span>
      </button>

      <!-- Reset Button -->
      <button id="btn-reset" type="button" class="btn-reset-filters" style="display:none">
        ✕ Limpiar
      </button>
    </div>

    <!-- Collapsible Glass Drawer -->
    <div id="filter-drawer" class="filter-drawer hidden">
      <!-- Inclusion Group -->
      <div class="drawer-section">
        <span class="drawer-title include-title">🎯 Incluir</span>
        <div class="drawer-grid">
          <select id="filter-system" class="filter-select" aria-label="Filtrar por sistema">
            <option value="all">Sistema: Todos ({counts.all})</option>
            <option value="2014">2014 ({counts.y2014})</option>
            <option value="2024">2024 / 5.5e ({counts.y2024})</option>
          </select>

          <select id="filter-class" class="filter-select" aria-label="Filtrar por clase">
            <option value="all">Clase: Todas</option>
            <option value="artificer">Artificer</option>
            <option value="barbarian">Barbarian</option>
            <option value="bard">Bard</option>
            <option value="cleric">Cleric</option>
            <option value="druid">Druid</option>
            <option value="fighter">Fighter</option>
            <option value="monk">Monk</option>
            <option value="paladin">Paladin</option>
            <option value="ranger">Ranger</option>
            <option value="rogue">Rogue</option>
            <option value="sorcerer">Sorcerer</option>
            <option value="warlock">Warlock</option>
            <option value="wizard">Wizard</option>
          </select>

          <select id="filter-role" class="filter-select" aria-label="Filtrar por rol">
            <option value="all">Rol: Todos</option>
            <option value="tanque">Tanque</option>
            <option value="atacante">Atacante (Striker)</option>
            <option value="controlador">Controlador</option>
            <option value="soporte">Soporte</option>
            <option value="lanzador">Lanzador (Blaster)</option>
            <option value="gish">Gish (Marcial-Mágico)</option>
            <option value="francotirador">Francotirador (Sniper)</option>
          </select>

          <select id="filter-score" class="filter-select" aria-label="Filtrar por puntuación total">
            <option value="all">Puntuación: Todas</option>
            <option value="tier-s">Tier S (≥ 75)</option>
            <option value="tier-a">Tier A (65 – 74)</option>
            <option value="tier-b">Tier B (55 – 64)</option>
            <option value="tier-c">Tier C (45 – 54)</option>
            <option value="tier-d">Tier D (35 – 44)</option>
            <option value="tier-f">Tier F (&lt; 35)</option>
          </select>
        </div>
      </div>

      <!-- Exclusion Group -->
      <div class="drawer-section">
        <span class="drawer-title exclude-title">🚫 Excluir</span>
        <div class="drawer-grid">
          <select id="exclude-class" class="filter-select filter-exclude" aria-label="Excluir clase">
            <option value="none">Excluir Clase: Ninguna</option>
            <option value="artificer">Artificer</option>
            <option value="barbarian">Barbarian</option>
            <option value="bard">Bard</option>
            <option value="cleric">Cleric</option>
            <option value="druid">Druid</option>
            <option value="fighter">Fighter</option>
            <option value="monk">Monk</option>
            <option value="paladin">Paladin</option>
            <option value="ranger">Ranger</option>
            <option value="rogue">Rogue</option>
            <option value="sorcerer">Sorcerer</option>
            <option value="warlock">Warlock</option>
            <option value="wizard">Wizard</option>
          </select>

          <select id="exclude-role" class="filter-select filter-exclude" aria-label="Excluir rol">
            <option value="none">Excluir Rol: Ninguno</option>
            <option value="tanque">Tanque</option>
            <option value="atacante">Atacante (Striker)</option>
            <option value="controlador">Controlador</option>
            <option value="soporte">Soporte</option>
            <option value="lanzador">Lanzador (Blaster)</option>
            <option value="gish">Gish (Marcial-Mágico)</option>
            <option value="francotirador">Francotirador (Sniper)</option>
          </select>

          <select id="exclude-system" class="filter-select filter-exclude" aria-label="Excluir sistema">
            <option value="none">Excluir Sistema: Ninguno</option>
            <option value="2014">2014</option>
            <option value="2024">2024 / 5.5e</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Active Badges Bar -->
    <div id="active-tags" class="active-tags-bar"></div>
  </div>

  <!-- ── Grid ────────────────────────────────────────────────────────────── -->
  <div class="builds-grid" id="builds-grid">
    {builds.map(build => (
      <div
        data-card
        data-system={build.system}
        data-name={build.name.toLowerCase()}
        data-classes={build.classes.toLowerCase()}
        data-role={build.role.toLowerCase()}
        data-total={build.total}
        data-dpr={build.ratings.dpr}
        data-ehp={build.ratings.ehp}
        data-control={build.ratings.control}
        data-support={build.ratings.support}
        data-utility={build.ratings.utility}
        data-complexity={build.ratings.complexity}
      >
        <BuildCard build={build} />
      </div>
    ))}
    <p class="empty-state" id="no-results" style="display:none">
      No se encontraron builds con ese criterio.
    </p>
  </div>

  <!-- Floating Comparison Action Bar -->
  <div id="compare-float-bar" class="compare-float-bar" style="display:none">
    <div class="compare-float-inner">
      <span id="compare-float-text" class="compare-float-text">0 personajes seleccionados</span>
      <div class="compare-float-btns">
        <button id="compare-float-clear" type="button" class="compare-float-clear">Limpiar</button>
        <a id="compare-float-launch" href={`${base}compare`} class="compare-float-launch">Comparar Lado a Lado ⚔️</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const grid = document.getElementById('builds-grid') as HTMLElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  
  const searchInput = document.getElementById('build-search') as HTMLInputElement;
  const sortBySelect = document.getElementById('sort-by') as HTMLSelectElement;
  const sortDirBtn = document.getElementById('sort-dir') as HTMLButtonElement;
  const sortDirIcon = document.getElementById('sort-dir-icon') as HTMLElement;
  const sortDirText = document.getElementById('sort-dir-text') as HTMLElement;

  const btnToggleDrawer = document.getElementById('btn-toggle-drawer') as HTMLButtonElement;
  const filterDrawer = document.getElementById('filter-drawer') as HTMLElement;
  const badgeCount = document.getElementById('filter-badge-count') as HTMLElement;
  const drawerArrow = document.getElementById('drawer-arrow') as HTMLElement;

  const systemSelect = document.getElementById('filter-system') as HTMLSelectElement;
  const classSelect = document.getElementById('filter-class') as HTMLSelectElement;
  const roleSelect = document.getElementById('filter-role') as HTMLSelectElement;
  const scoreSelect = document.getElementById('filter-score') as HTMLSelectElement;

  const excludeClassSelect = document.getElementById('exclude-class') as HTMLSelectElement;
  const excludeRoleSelect = document.getElementById('exclude-role') as HTMLSelectElement;
  const excludeSystemSelect = document.getElementById('exclude-system') as HTMLSelectElement;

  const resetBtn = document.getElementById('btn-reset') as HTMLButtonElement;
  const activeTagsContainer = document.getElementById('active-tags') as HTMLElement;
  const noResults = document.getElementById('no-results')!;

  let sortAscending = false;

  btnToggleDrawer?.addEventListener('click', () => {
    const isHidden = filterDrawer.classList.toggle('hidden');
    btnToggleDrawer.classList.toggle('active', !isHidden);
    btnToggleDrawer.setAttribute('aria-expanded', String(!isHidden));
    if (drawerArrow) drawerArrow.textContent = isHidden ? '▼' : '▲';
  });

  function matchRoleFilter(roleText: string, filterVal: string) {
    if (filterVal === 'all' || filterVal === 'none') return true;
    const r = roleText.toLowerCase();
    const v = filterVal.toLowerCase();
    if (v === 'tanque' || v === 'tank') return r.includes('tanque') || r.includes('tank');
    if (v === 'atacante' || v === 'striker') return r.includes('atacante') || r.includes('striker');
    if (v === 'controlador' || v === 'controller') return r.includes('controlador') || r.includes('control') || r.includes('controller');
    if (v === 'soporte' || v === 'support') return r.includes('soporte') || r.includes('sanador') || r.includes('apoyo') || r.includes('support');
    if (v === 'lanzador' || v === 'blaster') return r.includes('lanzador') || r.includes('blaster');
    if (v === 'gish') return r.includes('gish');
    if (v === 'francotirador' || v === 'sniper') return r.includes('francotirador') || r.includes('sniper');
    return r.includes(v);
  }

  function renderActiveTags() {
    if (!activeTagsContainer) return;
    activeTagsContainer.innerHTML = '';
    let countActive = 0;

    const addTag = (text: string, isExclude: boolean, clearFn: () => void) => {
      countActive++;
      const tag = document.createElement('span');
      tag.className = `tag-badge ${isExclude ? 'tag-badge-exclude' : 'tag-badge-include'}`;
      tag.textContent = text + ' ';
      const closeBtn = document.createElement('button');
      closeBtn.className = 'tag-close';
      closeBtn.textContent = '×';
      closeBtn.onclick = (e) => {
        e.preventDefault();
        clearFn();
        applyFiltersAndSort();
      };
      tag.appendChild(closeBtn);
      activeTagsContainer.appendChild(tag);
    };

    const sysVal = systemSelect?.value ?? 'all';
    if (sysVal !== 'all') addTag(`Sistema: ${sysVal}`, false, () => { systemSelect.value = 'all'; });

    const classVal = classSelect?.value ?? 'all';
    if (classVal !== 'all') addTag(`Clase: ${classVal}`, false, () => { classSelect.value = 'all'; });

    const roleVal = roleSelect?.value ?? 'all';
    if (roleVal !== 'all') addTag(`Rol: ${roleVal}`, false, () => { roleSelect.value = 'all'; });

    const scoreVal = scoreSelect?.value ?? 'all';
    if (scoreVal !== 'all') addTag(`Puntuación: ${scoreVal}`, false, () => { scoreSelect.value = 'all'; });

    const exClassVal = excludeClassSelect?.value ?? 'none';
    if (exClassVal !== 'none') addTag(`Excluir Clase: ${exClassVal}`, true, () => { excludeClassSelect.value = 'none'; });
    excludeClassSelect?.classList.toggle('has-active-exclude', exClassVal !== 'none');

    const exRoleVal = excludeRoleSelect?.value ?? 'none';
    if (exRoleVal !== 'none') addTag(`Excluir Rol: ${exRoleVal}`, true, () => { excludeRoleSelect.value = 'none'; });
    excludeRoleSelect?.classList.toggle('has-active-exclude', exRoleVal !== 'none');

    const exSysVal = excludeSystemSelect?.value ?? 'none';
    if (exSysVal !== 'none') addTag(`Excluir Sistema: ${exSysVal}`, true, () => { excludeSystemSelect.value = 'none'; });
    excludeSystemSelect?.classList.toggle('has-active-exclude', exSysVal !== 'none');

    const rawQuery = searchInput?.value.trim() ?? '';
    if (rawQuery) {
      const tokens = rawQuery.split(/\s+/);
      tokens.forEach(token => {
        if (token.startsWith('-') && token.length > 1) {
          addTag(`Excluir: "${token.slice(1)}"`, true, () => {
            searchInput.value = tokens.filter(t => t !== token).join(' ');
          });
        } else if (token) {
          addTag(`Buscar: "${token}"`, false, () => {
            searchInput.value = tokens.filter(t => t !== token).join(' ');
          });
        }
      });
    }

    if (badgeCount) {
      badgeCount.textContent = String(countActive);
      badgeCount.style.display = countActive > 0 ? 'inline-block' : 'none';
    }

    if (resetBtn) {
      resetBtn.style.display = countActive > 0 ? 'inline-flex' : 'none';
    }
  }

  function applyFiltersAndSort() {
    const rawQuery = searchInput?.value.toLowerCase().trim() ?? '';
    const sysVal = systemSelect?.value ?? 'all';
    const classVal = classSelect?.value ?? 'all';
    const roleVal = roleSelect?.value ?? 'all';
    const scoreVal = scoreSelect?.value ?? 'all';

    const exClassVal = excludeClassSelect?.value ?? 'none';
    const exRoleVal = excludeRoleSelect?.value ?? 'none';
    const exSysVal = excludeSystemSelect?.value ?? 'none';

    // Parse search text tokens into include and exclude criteria
    const tokens = rawQuery ? rawQuery.split(/\s+/).filter(Boolean) : [];
    const includeTokens = tokens.filter(t => !t.startsWith('-'));
    const excludeTokens = tokens.filter(t => t.startsWith('-') && t.length > 1).map(t => t.slice(1));

    let visibleCount = 0;

    cards.forEach(card => {
      const sys = card.dataset.system ?? '';
      const name = card.dataset.name ?? '';
      const classes = card.dataset.classes ?? '';
      const role = card.dataset.role ?? '';
      const total = Number(card.dataset.total ?? '0');

      // Include checks
      const matchSys = sysVal === 'all' || sys.includes(sysVal);
      const matchClass = classVal === 'all' || classes.includes(classVal);
      const matchRole = matchRoleFilter(role, roleVal);

      let matchScore = true;
      if      (scoreVal === 'tier-s') matchScore = total >= 75;
      else if (scoreVal === 'tier-a') matchScore = total >= 65 && total < 75;
      else if (scoreVal === 'tier-b') matchScore = total >= 55 && total < 65;
      else if (scoreVal === 'tier-c') matchScore = total >= 45 && total < 55;
      else if (scoreVal === 'tier-d') matchScore = total >= 35 && total < 45;
      else if (scoreVal === 'tier-f') matchScore = total < 35;

      // Search text include tokens
      const cardText = `${name} ${classes} ${role} ${sys}`.toLowerCase();
      const matchSearchInclude = includeTokens.every(token => cardText.includes(token));

      // Explicit Exclude checks
      const matchExClass = exClassVal === 'none' || !classes.includes(exClassVal);
      const matchExRole = exRoleVal === 'none' || !matchRoleFilter(role, exRoleVal);
      const matchExSys = exSysVal === 'none' || !sys.includes(exSysVal);

      // Search text exclude tokens
      const matchSearchExclude = excludeTokens.every(token => !cardText.includes(token));

      const show = matchSys && matchClass && matchRole && matchScore &&
                   matchExClass && matchExRole && matchExSys &&
                   matchSearchInclude && matchSearchExclude;

      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? '' : 'none';

    // ── Sorting ─────────────────────────────────────────────────────────────
    const sortByKey = sortBySelect?.value ?? 'total';

    cards.sort((a, b) => {
      let valA: string | number = 0;
      let valB: string | number = 0;

      if (sortByKey === 'name') {
        valA = a.dataset.name ?? '';
        valB = b.dataset.name ?? '';
        const comp = (valA as string).localeCompare(valB as string);
        return sortAscending ? comp : -comp;
      } else {
        valA = Number(a.dataset[sortByKey] ?? '0');
        valB = Number(b.dataset[sortByKey] ?? '0');
        return sortAscending ? (valA as number) - (valB as number) : (valB as number) - (valA as number);
      }
    });

    // Re-append cards to DOM in sorted order
    cards.forEach(card => grid.appendChild(card));
    // Ensure noResults message stays at the end
    grid.appendChild(noResults);

    renderActiveTags();
  }

  // Event Listeners
  searchInput?.addEventListener('input', applyFiltersAndSort);
  sortBySelect?.addEventListener('change', applyFiltersAndSort);

  sortDirBtn?.addEventListener('click', () => {
    sortAscending = !sortAscending;
    if (sortDirIcon) sortDirIcon.textContent = sortAscending ? '↑' : '↓';
    if (sortDirText) sortDirText.textContent = sortAscending ? 'Asc' : 'Desc';
    applyFiltersAndSort();
  });

  systemSelect?.addEventListener('change', applyFiltersAndSort);
  classSelect?.addEventListener('change', applyFiltersAndSort);
  roleSelect?.addEventListener('change', applyFiltersAndSort);
  scoreSelect?.addEventListener('change', applyFiltersAndSort);

  excludeClassSelect?.addEventListener('change', applyFiltersAndSort);
  excludeRoleSelect?.addEventListener('change', applyFiltersAndSort);
  excludeSystemSelect?.addEventListener('change', applyFiltersAndSort);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (sortBySelect) sortBySelect.value = 'total';
    sortAscending = false;
    if (sortDirIcon) sortDirIcon.textContent = '↓';
    if (sortDirText) sortDirText.textContent = 'Desc';

    if (systemSelect) systemSelect.value = 'all';
    if (classSelect) classSelect.value = 'all';
    if (roleSelect) roleSelect.value = 'all';
    if (scoreSelect) scoreSelect.value = 'all';

    if (excludeClassSelect) excludeClassSelect.value = 'none';
    if (excludeRoleSelect) excludeRoleSelect.value = 'none';
    if (excludeSystemSelect) excludeSystemSelect.value = 'none';

    applyFiltersAndSort();
  });

  // Initial call
  applyFiltersAndSort();

  // ── Floating comparison handler ───────────────────────────────────────────
  const compareBtns = document.querySelectorAll('[data-compare-id]');
  const floatBar = document.getElementById('compare-float-bar');
  const floatText = document.getElementById('compare-float-text');
  const floatClear = document.getElementById('compare-float-clear');
  const floatLaunch = document.getElementById('compare-float-launch') as HTMLAnchorElement | null;

  function getStoredCompare(): string[] {
    try {
      return JSON.parse(localStorage.getItem('dnd_compare_builds') || '[]');
    } catch(e) { return []; }
  }

  function saveStoredCompare(list: string[]) {
    try {
      localStorage.setItem('dnd_compare_builds', JSON.stringify(list));
    } catch(e) {}
  }

  function updateFloatBar() {
    const list = getStoredCompare();
    compareBtns.forEach(btn => {
      const id = (btn as HTMLElement).dataset.compareId!;
      const selected = list.includes(id);
      btn.classList.toggle('active', selected);
      btn.textContent = selected ? '✓ Añadido' : '+ Comparar';
    });

    if (floatBar) {
      if (list.length > 0) {
        floatBar.style.display = 'flex';
        if (floatText) floatText.textContent = `${list.length} personaje${list.length > 1 ? 's' : ''} para comparar`;
        if (floatLaunch) {
          const baseAttr = floatLaunch.getAttribute('href')?.split('?')[0] || '';
          floatLaunch.href = `${baseAttr}?builds=${list.join(',')}`;
        }
      } else {
        floatBar.style.display = 'none';
      }
    }
  }

  compareBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = (btn as HTMLElement).dataset.compareId!;
      let list = getStoredCompare();
      if (list.includes(id)) {
        list = list.filter(x => x !== id);
      } else {
        list.push(id);
      }
      saveStoredCompare(list);
      updateFloatBar();
    });
  });

  floatClear?.addEventListener('click', () => {
    saveStoredCompare([]);
    updateFloatBar();
  });

  updateFloatBar();
</script>
