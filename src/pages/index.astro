---
import Layout from '../layouts/Layout.astro';
import BuildCard from '../components/BuildCard.astro';
import buildsData from '../../builds.json';

const base = import.meta.env.BASE_URL;

const builds = buildsData.map(b => ({
  ...b,
  total: Math.round((b.ratings.dpr + b.ratings.ehp + b.ratings.control + b.ratings.support + b.ratings.utility) / 5)
}));

const counts = {
  all: builds.length,
  y2014: builds.filter(b => b.system.includes('2014')).length,
  y2024: builds.filter(b => b.system.includes('2024')).length,
};
---

<Layout title="Compendio de Builds">
  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <h1 class="hero-title">D&amp;D Builds</h1>
    <p class="hero-subtitle">
      Compendio de personajes optimizados para D&amp;D 5e,<br />
      analizados por el Archivero del Multiverso.
    </p>
    <span class="hero-count">
      <strong>{counts.all}</strong> builds catalogadas
    </span>
  </section>

  <!-- ── Filters ─────────────────────────────────────────────────────────── -->
  <div class="filter-panel">
    <div class="filter-main-bar">
      <div class="search-wrap">
        <svg class="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="build-search"
          type="search"
          class="search-input"
          placeholder="Buscar... (ej: -wizard o -2014 para excluir)"
          aria-label="Buscar builds"
          autocomplete="off"
        />
      </div>

      <!-- Sorter -->
      <div class="filter-item">
        <select id="sort-by" class="filter-select filter-sort" aria-label="Ordenar por">
          <option value="total">Ordenar: Puntuación Total</option>
          <option value="dpr">Ordenar: DPR</option>
          <option value="ehp">Ordenar: EHP</option>
          <option value="control">Ordenar: Control</option>
          <option value="support">Ordenar: Soporte</option>
          <option value="utility">Ordenar: Utilidad</option>
          <option value="complexity">Ordenar: Complejidad</option>
          <option value="name">Ordenar: Nombre</option>
        </select>
        <button id="sort-dir" type="button" class="btn-sort-dir" title="Cambiar dirección de orden (Descendente/Ascendente)" aria-label="Dirección de orden">
          <span id="sort-dir-icon">↓</span> <span id="sort-dir-text">Desc</span>
        </button>
      </div>

      <!-- Toggle Drawer Button -->
      <button id="btn-toggle-drawer" type="button" class="btn-toggle-filters" aria-expanded="false">
        <span>🎛️ Filtros &amp; Exclusiones</span>
        <span id="filter-badge-count" class="badge-count" style="display:none">0</span>
        <span id="drawer-arrow">▼</span>
      </button>

      <!-- Reset Button -->
      <button id="btn-reset" type="button" class="btn-reset-filters" style="display:none">
        ✕ Limpiar
      </button>
    </div>

    <!-- Collapsible Glass Drawer -->
    <div id="filter-drawer" class="filter-drawer hidden">
      <!-- Inclusion Group -->
      <div class="drawer-section">
        <span class="drawer-title include-title">🎯 Incluir</span>
        <div class="drawer-grid">
          <div class="multi-select" id="ms-system" data-placeholder="Sistema: Todos" data-type="include">
            <button type="button" class="multi-select-btn">
              <span class="multi-select-label">Sistema: Todos</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option"><input type="checkbox" value="2014"> <span>2014</span></label>
              <label class="multi-select-option"><input type="checkbox" value="2024"> <span>2024 / 5.5e</span></label>
            </div>
          </div>

          <div class="multi-select" id="ms-class" data-placeholder="Clase: Todas" data-type="include">
            <button type="button" class="multi-select-btn">
              <span class="multi-select-label">Clase: Todas</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option"><input type="checkbox" value="artificer"> <span>Artificer</span></label>
              <label class="multi-select-option"><input type="checkbox" value="barbarian"> <span>Barbarian</span></label>
              <label class="multi-select-option"><input type="checkbox" value="bard"> <span>Bard</span></label>
              <label class="multi-select-option"><input type="checkbox" value="cleric"> <span>Cleric</span></label>
              <label class="multi-select-option"><input type="checkbox" value="druid"> <span>Druid</span></label>
              <label class="multi-select-option"><input type="checkbox" value="fighter"> <span>Fighter</span></label>
              <label class="multi-select-option"><input type="checkbox" value="monk"> <span>Monk</span></label>
              <label class="multi-select-option"><input type="checkbox" value="paladin"> <span>Paladin</span></label>
              <label class="multi-select-option"><input type="checkbox" value="ranger"> <span>Ranger</span></label>
              <label class="multi-select-option"><input type="checkbox" value="rogue"> <span>Rogue</span></label>
              <label class="multi-select-option"><input type="checkbox" value="sorcerer"> <span>Sorcerer</span></label>
              <label class="multi-select-option"><input type="checkbox" value="warlock"> <span>Warlock</span></label>
              <label class="multi-select-option"><input type="checkbox" value="wizard"> <span>Wizard</span></label>
            </div>
          </div>

          <div class="multi-select" id="ms-role" data-placeholder="Rol: Todos" data-type="include">
            <button type="button" class="multi-select-btn">
              <span class="multi-select-label">Rol: Todos</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option"><input type="checkbox" value="tanque"> <span>Tanque</span></label>
              <label class="multi-select-option"><input type="checkbox" value="atacante"> <span>Atacante (Striker)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="controlador"> <span>Controlador</span></label>
              <label class="multi-select-option"><input type="checkbox" value="soporte"> <span>Soporte</span></label>
              <label class="multi-select-option"><input type="checkbox" value="lanzador"> <span>Lanzador (Blaster)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="gish"> <span>Gish (Marcial-Mágico)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="francotirador"> <span>Francotirador (Sniper)</span></label>
            </div>
          </div>

          <div class="multi-select" id="ms-score" data-placeholder="Puntuación: Todas" data-type="include">
            <button type="button" class="multi-select-btn">
              <span class="multi-select-label">Puntuación: Todas</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option"><input type="checkbox" value="tier-s"> <span>Tier S (≥ 75)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="tier-a"> <span>Tier A (65 – 74)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="tier-b"> <span>Tier B (55 – 64)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="tier-c"> <span>Tier C (45 – 54)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="tier-d"> <span>Tier D (35 – 44)</span></label>
              <label class="multi-select-option"><input type="checkbox" value="tier-f"> <span>Tier F (&lt; 35)</span></label>
            </div>
          </div>
        </div>
      </div>

      <!-- Exclusion Group -->
      <div class="drawer-section">
        <span class="drawer-title exclude-title">🚫 Excluir</span>
        <div class="drawer-grid">
          <div class="multi-select" id="ms-exclude-class" data-placeholder="Excluir Clase: Ninguna" data-type="exclude">
            <button type="button" class="multi-select-btn filter-exclude">
              <span class="multi-select-label">Excluir Clase: Ninguna</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option is-exclude"><input type="checkbox" value="artificer"> <span>Artificer</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="barbarian"> <span>Barbarian</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="bard"> <span>Bard</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="cleric"> <span>Cleric</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="druid"> <span>Druid</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="fighter"> <span>Fighter</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="monk"> <span>Monk</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="paladin"> <span>Paladin</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="ranger"> <span>Ranger</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="rogue"> <span>Rogue</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="sorcerer"> <span>Sorcerer</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="warlock"> <span>Warlock</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="wizard"> <span>Wizard</span></label>
            </div>
          </div>

          <div class="multi-select" id="ms-exclude-role" data-placeholder="Excluir Rol: Ninguno" data-type="exclude">
            <button type="button" class="multi-select-btn filter-exclude">
              <span class="multi-select-label">Excluir Rol: Ninguno</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option is-exclude"><input type="checkbox" value="tanque"> <span>Tanque</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="atacante"> <span>Atacante (Striker)</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="controlador"> <span>Controlador</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="soporte"> <span>Soporte</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="lanzador"> <span>Lanzador (Blaster)</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="gish"> <span>Gish (Marcial-Mágico)</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="francotirador"> <span>Francotirador (Sniper)</span></label>
            </div>
          </div>

          <div class="multi-select" id="ms-exclude-system" data-placeholder="Excluir Sistema: Ninguno" data-type="exclude">
            <button type="button" class="multi-select-btn filter-exclude">
              <span class="multi-select-label">Excluir Sistema: Ninguno</span>
              <span class="multi-select-arrow">▼</span>
            </button>
            <div class="multi-select-popover hidden">
              <label class="multi-select-option is-exclude"><input type="checkbox" value="2014"> <span>2014</span></label>
              <label class="multi-select-option is-exclude"><input type="checkbox" value="2024"> <span>2024 / 5.5e</span></label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Badges Bar -->
    <div id="active-tags" class="active-tags-bar"></div>
  </div>

  <!-- ── Grid ────────────────────────────────────────────────────────────── -->
  <div class="builds-grid" id="builds-grid">
    {builds.map(build => (
      <BuildCard build={build} />
    ))}
    <p class="empty-state" id="no-results" style="display:none">
      No se encontraron builds con ese criterio.
    </p>
  </div>

  <!-- Floating Comparison Action Bar -->
  <div id="compare-float-bar" class="compare-float-bar" style="display:none">
    <div class="compare-float-inner">
      <span id="compare-float-text" class="compare-float-text">0 personajes seleccionados</span>
      <div class="compare-float-btns">
        <button id="compare-float-clear" type="button" class="compare-float-clear">Limpiar</button>
        <a id="compare-float-launch" href={`${base}compare`} class="compare-float-launch">Comparar Lado a Lado ⚔️</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput   = document.getElementById('build-search') as HTMLInputElement;
  const sortBySelect  = document.getElementById('sort-by') as HTMLSelectElement;
  const sortDirBtn    = document.getElementById('sort-dir') as HTMLButtonElement;
  const sortDirIcon   = document.getElementById('sort-dir-icon') as HTMLElement;
  const sortDirText   = document.getElementById('sort-dir-text') as HTMLElement;

  const btnToggleDrawer = document.getElementById('btn-toggle-drawer') as HTMLButtonElement;
  const filterDrawer    = document.getElementById('filter-drawer') as HTMLElement;
  const badgeCount      = document.getElementById('filter-badge-count') as HTMLElement;
  const drawerArrow     = document.getElementById('drawer-arrow') as HTMLElement;

  const resetBtn            = document.getElementById('btn-reset') as HTMLButtonElement;
  const activeTagsContainer = document.getElementById('active-tags') as HTMLElement;

  const grid      = document.getElementById('builds-grid')!;
  const cards     = Array.from(grid.querySelectorAll<HTMLElement>('.build-card'));
  const noResults = document.getElementById('no-results')!;

  let sortAscending = false;

  btnToggleDrawer?.addEventListener('click', () => {
    const isHidden = filterDrawer.classList.toggle('hidden');
    btnToggleDrawer.classList.toggle('active', !isHidden);
    btnToggleDrawer.setAttribute('aria-expanded', String(!isHidden));
    if (drawerArrow) drawerArrow.textContent = isHidden ? '▼' : '▲';
  });

  // ── Multi-Select Helper Functions ─────────────────────────────────────────
  const MS_IDS = [
    'ms-system', 'ms-class', 'ms-role', 'ms-score',
    'ms-exclude-class', 'ms-exclude-role', 'ms-exclude-system'
  ];

  function getSelectedValues(msId: string): string[] {
    const container = document.getElementById(msId);
    if (!container) return [];
    return [...container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map(cb => cb.value);
  }

  function setSelectedValues(msId: string, values: string[]) {
    const container = document.getElementById(msId);
    if (!container) return;
    const checkboxes = container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    checkboxes.forEach(cb => { cb.checked = values.includes(cb.value); });
    updateMultiSelectLabel(msId);
  }

  function unselectValue(msId: string, value: string) {
    const current = getSelectedValues(msId);
    setSelectedValues(msId, current.filter(v => v !== value));
  }

  function updateMultiSelectLabel(msId: string) {
    const container = document.getElementById(msId);
    if (!container) return;
    const btn = container.querySelector<HTMLButtonElement>('.multi-select-btn');
    const label = container.querySelector<HTMLElement>('.multi-select-label');
    const placeholder = container.dataset.placeholder || '';
    const isExclude = container.dataset.type === 'exclude';
    const checked = [...container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')];

    if (!btn || !label) return;

    if (checked.length === 0) {
      label.textContent = placeholder;
      btn.classList.remove('active');
      if (isExclude) btn.classList.remove('has-active-exclude');
    } else if (checked.length === 1) {
      const text = checked[0].nextElementSibling?.textContent || checked[0].value;
      const prefix = isExclude ? 'Excluir: ' : '';
      label.textContent = `${prefix}${text}`;
      btn.classList.add('active');
      if (isExclude) btn.classList.add('has-active-exclude');
    } else {
      const prefix = isExclude ? 'Excluir: ' : '';
      label.textContent = `${prefix}${checked.length} seleccionados`;
      btn.classList.add('active');
      if (isExclude) btn.classList.add('has-active-exclude');
    }
  }

  // Setup Multi-Select Event Delegation & Popover Toggling
  MS_IDS.forEach(msId => {
    const container = document.getElementById(msId);
    if (!container) return;
    const btn = container.querySelector<HTMLButtonElement>('.multi-select-btn');
    const popover = container.querySelector<HTMLElement>('.multi-select-popover');

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other popovers
      MS_IDS.forEach(otherId => {
        if (otherId !== msId) {
          document.getElementById(otherId)?.querySelector('.multi-select-popover')?.classList.add('hidden');
        }
      });
      popover?.classList.toggle('hidden');
    });

    container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', () => {
        updateMultiSelectLabel(msId);
        applyFiltersAndSort();
      });
    });
  });

  // Close popovers on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.multi-select')) {
      MS_IDS.forEach(msId => {
        document.getElementById(msId)?.querySelector('.multi-select-popover')?.classList.add('hidden');
      });
    }
  });

  function matchRoleFilter(roleText: string, filterVal: string) {
    const r = roleText.toLowerCase();
    const v = filterVal.toLowerCase();
    if (v === 'tanque' || v === 'tank') return r.includes('tanque') || r.includes('tank');
    if (v === 'atacante' || v === 'striker') return r.includes('atacante') || r.includes('striker');
    if (v === 'controlador' || v === 'controller') return r.includes('controlador') || r.includes('control') || r.includes('controller');
    if (v === 'soporte' || v === 'support') return r.includes('soporte') || r.includes('sanador') || r.includes('apoyo') || r.includes('support');
    if (v === 'lanzador' || v === 'blaster') return r.includes('lanzador') || r.includes('blaster');
    if (v === 'gish') return r.includes('gish');
    if (v === 'francotirador' || v === 'sniper') return r.includes('francotirador') || r.includes('sniper');
    return r.includes(v);
  }

  function matchScoreFilter(totalScore: number, filterVal: string): boolean {
    if (filterVal === 'tier-s') return totalScore >= 75;
    if (filterVal === 'tier-a') return totalScore >= 65 && totalScore < 75;
    if (filterVal === 'tier-b') return totalScore >= 55 && totalScore < 65;
    if (filterVal === 'tier-c') return totalScore >= 45 && totalScore < 55;
    if (filterVal === 'tier-d') return totalScore >= 35 && totalScore < 45;
    if (filterVal === 'tier-f') return totalScore < 35;
    return true;
  }

  function renderActiveTags() {
    if (!activeTagsContainer) return;
    activeTagsContainer.innerHTML = '';
    let countActive = 0;

    const addTag = (text: string, isExclude: boolean, clearFn: () => void) => {
      countActive++;
      const tag = document.createElement('span');
      tag.className = `tag-badge ${isExclude ? 'tag-badge-exclude' : 'tag-badge-include'}`;
      tag.textContent = text + ' ';
      const closeBtn = document.createElement('button');
      closeBtn.className = 'tag-close';
      closeBtn.textContent = '×';
      closeBtn.onclick = (e) => {
        e.preventDefault();
        clearFn();
        applyFiltersAndSort();
      };
      tag.appendChild(closeBtn);
      activeTagsContainer.appendChild(tag);
    };

    // System Includes
    getSelectedValues('ms-system').forEach(v => {
      addTag(`Sistema: ${v}`, false, () => unselectValue('ms-system', v));
    });

    // Class Includes
    getSelectedValues('ms-class').forEach(v => {
      addTag(`Clase: ${v}`, false, () => unselectValue('ms-class', v));
    });

    // Role Includes
    getSelectedValues('ms-role').forEach(v => {
      addTag(`Rol: ${v}`, false, () => unselectValue('ms-role', v));
    });

    // Score Includes
    getSelectedValues('ms-score').forEach(v => {
      addTag(`Puntuación: ${v.toUpperCase()}`, false, () => unselectValue('ms-score', v));
    });

    // Excludes
    getSelectedValues('ms-exclude-class').forEach(v => {
      addTag(`Excluir Clase: ${v}`, true, () => unselectValue('ms-exclude-class', v));
    });

    getSelectedValues('ms-exclude-role').forEach(v => {
      addTag(`Excluir Rol: ${v}`, true, () => unselectValue('ms-exclude-role', v));
    });

    getSelectedValues('ms-exclude-system').forEach(v => {
      addTag(`Excluir Sistema: ${v}`, true, () => unselectValue('ms-exclude-system', v));
    });

    // Text Search Tokens
    const rawQuery = searchInput?.value.trim() ?? '';
    if (rawQuery) {
      const tokens = rawQuery.split(/\s+/);
      tokens.forEach(token => {
        if (token.startsWith('-') && token.length > 1) {
          addTag(`Excluir: "${token.slice(1)}"`, true, () => {
            searchInput.value = tokens.filter(t => t !== token).join(' ');
            applyFiltersAndSort();
          });
        } else if (token) {
          addTag(`Buscar: "${token}"`, false, () => {
            searchInput.value = tokens.filter(t => t !== token).join(' ');
            applyFiltersAndSort();
          });
        }
      });
    }

    if (badgeCount) {
      badgeCount.textContent = String(countActive);
      badgeCount.style.display = countActive > 0 ? 'inline-block' : 'none';
    }

    if (resetBtn) {
      resetBtn.style.display = countActive > 0 ? 'inline-flex' : 'none';
    }
  }

  function applyFiltersAndSort() {
    const rawQuery = searchInput?.value.toLowerCase().trim() ?? '';
    const sysVals   = getSelectedValues('ms-system');
    const classVals = getSelectedValues('ms-class');
    const roleVals  = getSelectedValues('ms-role');
    const scoreVals = getSelectedValues('ms-score');

    const exClassVals = getSelectedValues('ms-exclude-class');
    const exRoleVals  = getSelectedValues('ms-exclude-role');
    const exSysVals   = getSelectedValues('ms-exclude-system');

    const tokens = rawQuery ? rawQuery.split(/\s+/).filter(Boolean) : [];
    const includeTokens = tokens.filter(t => !t.startsWith('-'));
    const excludeTokens = tokens.filter(t => t.startsWith('-') && t.length > 1).map(t => t.slice(1));

    let visibleCount = 0;

    cards.forEach(card => {
      const sys = card.dataset.system ?? '';
      const name = card.dataset.name ?? '';
      const classes = card.dataset.classes ?? '';
      const role = card.dataset.role ?? '';
      const total = Number(card.dataset.total ?? '0');

      // Include checks (Multi-select OR logic)
      const matchSys   = sysVals.length === 0 || sysVals.some(v => sys.includes(v));
      const matchClass = classVals.length === 0 || classVals.some(v => classes.includes(v));
      const matchRole  = roleVals.length === 0 || roleVals.some(v => matchRoleFilter(role, v));
      const matchScore = scoreVals.length === 0 || scoreVals.some(v => matchScoreFilter(total, v));

      // Search text include tokens
      const cardText = `${name} ${classes} ${role} ${sys}`.toLowerCase();
      const matchSearchInclude = includeTokens.every(token => cardText.includes(token));

      // Explicit Exclude checks (Multi-select AND NOT logic)
      const matchExClass = exClassVals.length === 0 || !exClassVals.some(v => classes.includes(v));
      const matchExRole  = exRoleVals.length === 0 || !exRoleVals.some(v => matchRoleFilter(role, v));
      const matchExSys   = exSysVals.length === 0 || !exSysVals.some(v => sys.includes(v));

      // Search text exclude tokens
      const matchSearchExclude = excludeTokens.every(token => !cardText.includes(token));

      const show = matchSys && matchClass && matchRole && matchScore &&
                   matchExClass && matchExRole && matchExSys &&
                   matchSearchInclude && matchSearchExclude;

      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? '' : 'none';

    // ── Sorting ─────────────────────────────────────────────────────────────
    const sortByKey = sortBySelect?.value ?? 'total';

    cards.sort((a, b) => {
      if (sortByKey === 'name') {
        const valA = a.dataset.name ?? '';
        const valB = b.dataset.name ?? '';
        const comp = valA.localeCompare(valB);
        return sortAscending ? comp : -comp;
      } else {
        const valA = Number(a.dataset[sortByKey] ?? '0');
        const valB = Number(b.dataset[sortByKey] ?? '0');
        return sortAscending ? valA - valB : valB - valA;
      }
    });

    // Re-append cards to DOM in sorted order
    cards.forEach(card => grid.appendChild(card));
    grid.appendChild(noResults);

    renderActiveTags();
  }

  // Event Listeners
  searchInput?.addEventListener('input', applyFiltersAndSort);
  sortBySelect?.addEventListener('change', applyFiltersAndSort);

  sortDirBtn?.addEventListener('click', () => {
    sortAscending = !sortAscending;
    if (sortDirIcon) sortDirIcon.textContent = sortAscending ? '↑' : '↓';
    if (sortDirText) sortDirText.textContent = sortAscending ? 'Asc' : 'Desc';
    applyFiltersAndSort();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (sortBySelect) sortBySelect.value = 'total';
    sortAscending = false;
    if (sortDirIcon) sortDirIcon.textContent = '↓';
    if (sortDirText) sortDirText.textContent = 'Desc';

    MS_IDS.forEach(msId => setSelectedValues(msId, []));
    applyFiltersAndSort();
  });

  // Initial call
  applyFiltersAndSort();

  // ── Floating comparison handler ───────────────────────────────────────────
  const compareBtns = document.querySelectorAll('[data-compare-id]');
  const floatBar = document.getElementById('compare-float-bar');
  const floatText = document.getElementById('compare-float-text');
  const floatClear = document.getElementById('compare-float-clear');
  const floatLaunch = document.getElementById('compare-float-launch') as HTMLAnchorElement | null;

  function getStoredCompare(): string[] {
    try {
      return JSON.parse(localStorage.getItem('dnd_compare_builds') || '[]');
    } catch(e) { return []; }
  }

  function saveStoredCompare(list: string[]) {
    try {
      localStorage.setItem('dnd_compare_builds', JSON.stringify(list));
    } catch(e) {}
  }

  function updateFloatBar() {
    const list = getStoredCompare();
    compareBtns.forEach(btn => {
      const id = (btn as HTMLElement).dataset.compareId!;
      const selected = list.includes(id);
      btn.classList.toggle('active', selected);
      btn.textContent = selected ? '✓ Añadido' : '+ Comparar';
    });

    if (floatBar) {
      if (list.length > 0) {
        floatBar.style.display = 'flex';
        if (floatText) floatText.textContent = `${list.length} personaje${list.length > 1 ? 's' : ''} para comparar`;
        if (floatLaunch) {
          const baseAttr = floatLaunch.getAttribute('href')?.split('?')[0] || '';
          floatLaunch.href = `${baseAttr}?builds=${list.join(',')}`;
        }
      } else {
        floatBar.style.display = 'none';
      }
    }
  }

  compareBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = (btn as HTMLElement).dataset.compareId!;
      let list = getStoredCompare();
      if (list.includes(id)) {
        list = list.filter(x => x !== id);
      } else {
        list.push(id);
      }
      saveStoredCompare(list);
      updateFloatBar();
    });
  });

  floatClear?.addEventListener('click', () => {
    saveStoredCompare([]);
    updateFloatBar();
  });

  updateFloatBar();
</script>
